---
/**
 * PROTOTYPE（首页第十四轮）神冈的水池。
 * 1987 年 2 月 23 日，大麦哲伦云里一颗星爆炸，16 万多光年外；它的中微子穿过地球，
 * 在岐阜神冈矿山地下 1,000 米的探测器里，不到 13 秒留下了 12 个。后来的超级神冈：50,220 吨超纯水、11,146 颗光电倍增管。
 * 粒子在水里比光还快，就发出一圈蓝色的切伦科夫光，打在罐壁上成一个环。
 * 第一屏就是水罐的内部：金色的管子铺满四周，蓝色的环一个接一个亮起来。每条记录是一次事件（见 tank.ts、kamioka.ts）。
 */
import type { HomeData } from '../../lib/home-data';
import { RING_NAME, RING_OF } from './tank';

interface Props {
  data: HomeData;
}
const { data } = Astro.props;
---

<div class="km" data-km>
  <section class="stage" data-stage aria-label="水罐内部：每一个蓝色的环是一条记录；可以拖动转头">
    <canvas data-gl></canvas>
    <div class="labels" data-labels></div>

    <div class="head">
      <p class="place">神冈</p>
      <p class="facts">地下 1,000 m　超纯水 50,220 t　光电倍增管 11,146 颗</p>
      <p class="intro" data-intro>1987 年 2 月 23 日 7:35 UT，不到 13 秒，12 个</p>
    </div>
    <p class="counter" data-counter>事件 №0000</p>
    <div class="now" aria-live="polite">
      <p class="title" data-title></p>
      <p class="sub" data-sub></p>
    </div>

    <ul class="key">
      {
        data.categories.map((c) => (
          <li>
            <span class={`mark ${RING_OF[c.key]}`} aria-hidden="true" />
            <span>{c.label}</span>
            <span class="ring">{RING_NAME[RING_OF[c.key]]}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="list" data-list aria-label="事件表">
    <h2>事件表</h2>
    <div class="groups">
      {
        data.categories.map((c) => (
          <section data-cat={c.key}>
            <h3>
              <span>{c.label}</span>
              <span class="ring">{RING_NAME[RING_OF[c.key]]}</span>
            </h3>
            <ol />
          </section>
        ))
      }
    </div>
  </section>
  <p class="sample-note" data-sample-note hidden>示意日期</p>
  <p hidden>神冈地下超纯水光电倍增管颗事件表再看一次年月日锐利的环发散的环一对环零星的光子电低能μπ⁰,0123456789 №mtUT个秒很久以前游戏视觉小说动画音乐</p>
</div>

<style>
  .km {
    --ink: #e3e9f2;
    --dim: color-mix(in srgb, var(--ink) 55%, #010409);
    --faint: color-mix(in srgb, var(--ink) 30%, #010409);
    --hair: color-mix(in srgb, var(--ink) 14%, #010409);
    --blue: #7cc0ff;
    --gold: #c49a52;
    --serif: 'Times New Roman', Times, Georgia, serif;

    color: var(--ink);
  }

  .km::before {
    position: fixed;
    inset: 0;
    z-index: -1;
    content: '';
    background: #010409;
  }

  .stage {
    position: relative;
    width: 100vw;
    height: calc(100svh - 4rem);
    min-height: 32rem;
    margin-left: calc(50% - 50vw);
    overflow: hidden;
    cursor: grab;
    touch-action: pan-y;
    user-select: none;
  }

  .stage:active {
    cursor: grabbing;
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .labels {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .labels :global(.ring-label) {
    position: absolute;
    top: 0;
    left: 0;
    display: grid;
    gap: 0.2rem;
    justify-items: center;
    width: max-content;
    max-width: 18rem;
    margin: -1.2rem 0 0;
    color: #fff;
    text-align: center;
    text-decoration: none;
    text-shadow: 0 0 12px rgb(0 20 60 / 0.9), 0 0 2px rgb(0 0 0 / 0.9);
    pointer-events: auto;
    translate: -50% 0;
    will-change: transform, opacity;
  }

  .labels :global(.ring-label .t) {
    font-size: 1.125rem;
    letter-spacing: 0.04em;
  }

  .labels :global(.ring-label .s) {
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    color: var(--blue);
  }

  .head,
  .counter,
  .now,
  .key {
    position: absolute;
    margin: 0;
    pointer-events: none;
  }

  .head {
    top: 1.5rem;
    left: max(clamp(1rem, 4vw, 2.5rem), env(safe-area-inset-left));
  }

  .head p {
    margin: 0;
  }

  .place {
    font-size: clamp(2.25rem, 4vw, 3.5rem);
    font-weight: 300;
    line-height: 1;
    letter-spacing: 0.5em;
  }

  .facts {
    margin-top: 0.75rem !important;
    font-size: 0.6875rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.2em;
    color: var(--dim);
  }

  .counter {
    top: 1.75rem;
    right: max(clamp(1rem, 4vw, 2.5rem), env(safe-area-inset-right));
    font-family: var(--serif);
    font-size: 1rem;
    font-style: italic;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
    color: var(--gold);
  }

  .intro {
    margin-top: 0.4rem !important;
    font-size: 0.6875rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.2em;
    color: var(--blue);
    transition: opacity 1.2s;
  }

  .intro[data-gone] {
    opacity: 0;
  }

  .now {
    bottom: 1.75rem;
    left: max(clamp(1rem, 4vw, 2.5rem), env(safe-area-inset-left));
    max-width: 24rem;
  }

  .now p {
    margin: 0;
  }

  .now .title {
    font-size: 1.5rem;
    line-height: 1.3;
  }

  .now .sub {
    margin-top: 0.4rem !important;
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    color: var(--dim);
  }

  .key {
    right: max(clamp(1rem, 4vw, 2.5rem), env(safe-area-inset-right));
    bottom: 1.75rem;
    display: grid;
    gap: 0.35rem;
    padding: 0;
    list-style: none;
    font-size: 0.75rem;
    color: var(--dim);
  }

  .key li {
    display: grid;
    grid-template-columns: 1.5rem 4.5rem auto;
    align-items: center;
  }

  .key .ring {
    color: var(--faint);
  }

  /* 四种环的小图例 */
  .mark {
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 50%;
  }

  .mark.mu {
    border: 1.5px solid var(--blue);
    background: radial-gradient(circle, rgb(124 192 255 / 0.25), transparent 70%);
  }

  .mark.e {
    border: 1px dashed var(--blue);
    box-shadow: 0 0 6px var(--blue);
  }

  .mark.pi0 {
    border: 1px solid var(--blue);
    box-shadow: 0.35rem 0 0 -1px #010409, 0.35rem 0 0 0 var(--blue);
  }

  .mark.low {
    background: radial-gradient(circle at 30% 30%, var(--blue) 0 1.5px, transparent 2px), radial-gradient(circle at 70% 60%, var(--blue) 0 1.5px, transparent 2px), radial-gradient(circle at 40% 80%, var(--blue) 0 1px, transparent 1.5px);
  }

  /* 事件表 */
  .list {
    padding: 12vh 0 14vh;
  }

  .list h2 {
    margin: 0 0 2.5rem;
    font-size: 0.875rem;
    font-weight: 400;
    letter-spacing: 0.6em;
    color: var(--dim);
  }

  .groups {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 3rem clamp(2rem, 4vw, 4rem);
  }

  .groups h3 {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 0.6rem;
    margin: 0 0 0.5rem;
    font-size: 1rem;
    font-weight: 400;
    border-bottom: 1px solid var(--hair);
  }

  .groups h3 .ring {
    font-size: 0.6875rem;
    color: var(--blue);
  }

  .groups ol {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .groups :global(li) {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    align-items: baseline;
    padding: 0.32rem 0;
  }

  .groups :global(a) {
    color: var(--ink);
    text-decoration: none;
  }

  .groups :global(button) {
    flex: none;
    padding: 0;
    font: inherit;
    font-size: 0.6875rem;
    letter-spacing: 0.15em;
    color: var(--faint);
    cursor: pointer;
    background: none;
    border: 0;
    transition: color 0.2s, letter-spacing 0.3s;
  }

  .groups :global(li:hover button),
  .groups :global(button:focus-visible) {
    letter-spacing: 0.3em;
    color: var(--blue);
    outline: none;
  }

  .sample-note {
    position: fixed;
    right: 1rem;
    bottom: 4.25rem;
    z-index: 5;
    margin: 0;
    font-size: 0.75rem;
    color: var(--dim);
  }

  @media (max-width: 51.24rem) {
    .stage {
      height: 42rem;
    }

    .place {
      letter-spacing: 0.3em;
    }

    .key {
      display: none;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .intro,
    .groups :global(button) {
      transition: none;
    }
  }
</style>
