---
import { render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { coverColor } from '../../lib/cover-color';
import { originalTitleLang, quoteLang } from '../../lib/original-title';
import RecordDate from '../voice/RecordDate.astro';
import Favorite from '../voice/Favorite.astro';
import ShortReview from '../voice/ShortReview.astro';
import ChosenQuote from '../voice/ChosenQuote.astro';
import LongReview from '../voice/LongReview.astro';

interface Props {
  song: CollectionEntry<'songs'>;
}

const { song } = Astro.props;
const { data } = song;
const color = data.cover && (await coverColor(data.cover));
// 单曲永远没有详情页：长评在音乐页上直接展开
const LongReviewContent = song.body?.trim() ? (await render(song)).Content : undefined;
---

<article style={color ? `--cover-color: ${color}` : undefined}>
  {data.cover && <Image src={data.cover} alt="" width={120} />}
  <h2 lang={originalTitleLang(data)}>{data.originalTitle}</h2>
  {data.translatedTitle && <p>{data.translatedTitle}</p>}
  <dl>
    <dt>演唱</dt>
    <dd>{data.singer}</dd>
    {
      data.producer && (
        <>
          <dt>P主</dt>
          <dd>{data.producer}</dd>
        </>
      )
    }
    {
      data.original && (
        <>
          <dt>原曲</dt>
          <dd>{data.original}</dd>
        </>
      )
    }
    {
      data.styles.length > 0 && (
        <>
          <dt>风格</dt>
          <dd>{data.styles.join('、')}</dd>
        </>
      )
    }
  </dl>
  {
    // 点播交给外壳里常驻的播放器（换页不中断）；按下的状态由播放器同步
    data.audio && (
      <button type="button" data-request={data.audio} data-request-title={data.originalTitle}
        data-request-lang={originalTitleLang(data)}
        aria-pressed="false"
      >
        播放
      </button>
    )
  }
  {
    data.links.length > 0 && (
      <ul>
        {data.links.map((link) => (
          <li>
            <a href={link.url} rel="noreferrer">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    )
  }
  <RecordDate date={data.added} />
  {data.favorite && <Favorite />}
  {data.shortReview && <ShortReview text={data.shortReview} />}
  {data.quotes.map((lyric) => <ChosenQuote {...lyric} lang={quoteLang(lyric.original, data)} />)}
  {
    LongReviewContent && (
      <details>
        <summary>长评</summary>
        <LongReview><LongReviewContent /></LongReview>
      </details>
    )
  }
</article>
