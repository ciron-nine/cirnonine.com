---
/**
 * PROTOTYPE：D 专辑内页（#19）的占位，只用来看背景和内容的层次：方形的纸页浮在背景上。
 * 不写文字（灰条代替），免得占位字进了字体子集；正式的小册子在 #19 里做。
 * 第一屏留空给背景，小册子从第二屏开始。
 */
const spreads = [
  [{ cover: true }, { bars: [5, 9, 7, 9, 6, 8, 4] }],
  [{ bars: [9, 8, 9, 7, 9, 8, 5] }, { bars: [7, 9, 6] }],
  [{ bars: [8, 6, 7, 8, 5] }, { bars: [4, 6, 5, 3] }],
];
---

<div class="first-screen" aria-hidden="true"></div>
<div class="booklet" aria-hidden="true">
  {
    spreads.map((pages) => (
      <div class="spread">
        {pages.map((page) => (
          <div class="page">
            {'cover' in page ? (
              <span class="avatar" />
            ) : (
              <>
                <span class="label" />
                {page.bars!.map((w) => (
                  <span class="bar" style={`--w:${w * 10}%`} />
                ))}
              </>
            )}
          </div>
        ))}
      </div>
    ))
  }
</div>

<style>
  .first-screen {
    height: calc(100svh - 6rem);
  }

  .booklet {
    display: grid;
    gap: 3rem;
    max-width: 64rem;
    margin: 0 auto;
  }

  .spread {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: var(--shell-bg);
    border: 1px solid var(--shell-rule);
    box-shadow: 0 12px 40px light-dark(rgb(0 0 0 / 0.08), rgb(0 0 0 / 0.5));
  }

  @media (max-width: 640px) {
    .spread {
      grid-template-columns: 1fr;
    }
  }

  .page {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    aspect-ratio: 1;
    padding: clamp(1.25rem, 5%, 2.5rem);
  }

  .page + .page {
    border-left: 1px solid var(--shell-rule);
  }

  @media (max-width: 640px) {
    .page + .page {
      border-top: 1px solid var(--shell-rule);
      border-left: 0;
    }
  }

  .avatar {
    width: 70%;
    aspect-ratio: 1;
    margin: auto;
    background: light-dark(rgb(0 0 0 / 0.06), rgb(255 255 255 / 0.07));
  }

  .label {
    width: 22%;
    height: 0.5rem;
    margin-bottom: 1rem;
    background: var(--shell-muted);
    opacity: 0.5;
  }

  .bar {
    width: var(--w);
    height: 0.5rem;
    background: light-dark(rgb(0 0 0 / 0.1), rgb(255 255 255 / 0.1));
  }
</style>
