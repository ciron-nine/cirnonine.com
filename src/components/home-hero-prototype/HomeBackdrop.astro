---
/**
 * PROTOTYPE（第二轮）：首页的全屏背景，三个数学变体，用 ?variant=A / B / C 切换，开发环境底部有切换条。
 * A Hopf 纤维化 / B 吸引子粒子流（Thomas）/ C 变形曲面（Klein 瓶 → Boy 曲面 → Enneper 曲面）。
 *
 * 背景钉在视口上、在页面内容后面，只在首页；外壳和其他页面不动（ADR-0004 只允许 WebGL 用在首页主视觉和专属页）。
 * 第一屏最浓，往下滚放慢、变淡（gl-common.ts）。
 *
 * 其他参数：?gl=0 强制静态后备；?sample=1 让 B 的记录粒子用示意数据（现在没有心头好）；
 * ?pulse=demo 用假的节拍看「跟着音乐呼吸」（R2 还没配 CORS，读不到真的背景音乐，见 pulse.ts）。
 */
import { loadHeroRecords, sampleRecords } from './hero-data';

const real = await loadHeroRecords();
const sample = sampleRecords(real, new Date());
/** 每条记录一个亮度：心头好 1，其余 0.4 */
const magnitudes = (records: typeof real) => records.map((r) => (r.favorite ? 1 : 0.4));

const VARIANTS = [
  { key: 'A', name: 'Hopf 纤维化', gl: 'hopf' },
  { key: 'B', name: '吸引子粒子流', gl: 'flow' },
  { key: 'C', name: '变形曲面', gl: 'surface' },
];
---

<div
  class="backdrop"
  aria-hidden="true"
  data-backdrop
  data-records={JSON.stringify(magnitudes(real))}
  data-records-sample={JSON.stringify(magnitudes(sample))}
>
  <div data-prototype-variants>
    {
      VARIANTS.map((v, i) => (
        <div data-variant={v.key} data-variant-name={v.name} hidden={i > 0}>
          <div class="frame" data-hero-frame data-gl-variant={v.gl}>
            {/* 原型里三张图只下载当前变体那张：地址先放在 data-* 里，backdrop.ts 换到这个变体时才填上。正式版只有一个变体，直接写 src */}
            <picture class="still">
              <source data-srcset={`/home-hero-prototype/${v.gl}-dark.webp`} media="(prefers-color-scheme: dark)" />
              <img data-src={`/home-hero-prototype/${v.gl}-light.webp`} alt="" width="800" height="800" decoding="async" />
            </picture>
          </div>
        </div>
      ))
    }
  </div>
</div>

<script>
  import './backdrop';
</script>

<style>
  .backdrop {
    /* 图形坐标 1 = --unit 的一半；和 gl-*.ts 里的 uUnit 一致 */
    --unit: calc(min(100vw, 100lvh) * 0.65 + max(100vw, 100lvh) * 0.35);
  }

  .frame {
    position: fixed;
    inset: 0 0 auto;
    z-index: -1;
    height: 100lvh;
    overflow: hidden;
    color: var(--shell-fg);
    background-color: var(--shell-bg);
  }

  [data-variant][hidden] {
    display: none;
  }

  .still {
    position: absolute;
    inset: 0;
    transition: opacity 900ms ease;
  }

  .still img {
    /* 图片比视口大，用绝对定位居中（grid 居中在溢出时会贴到一边） */
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    /* 静态图覆盖图形坐标 [-1.6, 1.6]（见 [variant]-[scheme].webp.ts 的 EXTENT） */
    width: calc(var(--unit) * 1.6);
    max-width: none;
    height: auto;
  }

  .frame :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 900ms ease;
  }

  .frame[data-gl='on'] :global(canvas) {
    opacity: 1;
  }

  .frame[data-gl='on'] .still {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .still,
    .frame :global(canvas) {
      transition: none;
    }
  }
</style>
