---
/**
 * PROTOTYPE 变体 C：夜空、缓慢流动的极光，偶尔一颗流星。极光的颜色取自记录封面的主色，每次来随机挑。
 * 静态后备是几层模糊的径向渐变（构建时用固定种子挑的颜色），加一点 CSS 星点。
 */
import type { HeroRecord } from './hero-data';
import { pickPalette, seeded } from './palette';

interface Props {
  records: HeroRecord[];
}
const { records } = Astro.props;
const sources = records.map((r) => ({ color: r.color, favorite: r.favorite }));
const still = pickPalette(sources, seeded(9));
while (still.length < 3) still.push(still[still.length - 1] ?? '#888888');
---

<div
  class="frame"
  data-hero-frame
  data-palette={JSON.stringify(sources)}
  style={still.map((c, i) => `--c${i}:${c}`).join(';')}
>
  <div class="still" aria-hidden="true"></div>
</div>

<style>
  .frame {
    position: relative;
    aspect-ratio: 2 / 1;
    max-height: 72svh;
    overflow: hidden;
    background: linear-gradient(to top, #0b0c0e, #020203 80%);
  }

  @media (max-width: 640px) {
    .frame {
      aspect-ratio: 1;
    }
  }

  .still {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 45% 22% at 28% 52%, color-mix(in srgb, var(--c0) 55%, transparent), transparent 70%),
      radial-gradient(ellipse 40% 26% at 62% 44%, color-mix(in srgb, var(--c1) 45%, transparent), transparent 70%),
      radial-gradient(ellipse 35% 18% at 80% 58%, color-mix(in srgb, var(--c2) 40%, transparent), transparent 70%),
      radial-gradient(1px 1px at 12% 18%, #fff8, transparent),
      radial-gradient(1px 1px at 37% 9%, #fff6, transparent),
      radial-gradient(1px 1px at 71% 22%, #fff7, transparent),
      radial-gradient(1px 1px at 88% 12%, #fff5, transparent),
      radial-gradient(1px 1px at 54% 28%, #fff6, transparent);
    filter: blur(0.5px);
    transition: opacity 900ms ease;
  }

  .frame :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 900ms ease;
  }

  .frame[data-gl='on'] :global(canvas) {
    opacity: 1;
  }

  .frame[data-gl='on'] .still {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .still,
    .frame :global(canvas) {
      transition: none;
    }
  }
</style>
