---
/**
 * PROTOTYPE：首页主视觉的三个 WebGL 变体，用 ?variant=A / B / C 切换，开发环境底部有切换条。
 * 问题：首页主视觉用哪种 WebGL 效果？A 函数三维 / B 记录星图 / C 极光与流星。
 * 只占首页主视觉这一块，外壳不动，不做成全站背景（ADR-0004、ADR-0005）。
 * 选定后把胜出的方案按正式代码重写进 #19 的首页，落选的变体和切换条只留在 prototype/home-hero 分支。
 *
 * 其他参数：?sample=1 让 B、C 用示意数据（现在的种子数据全是占位封面、没有心头好、日期都是很久以前）；
 * ?gl=0 强制显示静态后备，看没有 WebGL 时的样子。
 */
import { loadHeroRecords, sampleRecords } from './hero-data';
import VariantA from './VariantA.astro';
import VariantB from './VariantB.astro';
import VariantC from './VariantC.astro';

const now = new Date();
const real = await loadHeroRecords();
const sample = sampleRecords(real, now);
---

<section class="hero" aria-label="主视觉" data-hero>
  <div data-prototype-variants>
    <div data-variant="A" data-variant-name="函数三维">
      <VariantA />
    </div>
    <div data-variant="B" data-variant-name="记录星图" hidden>
      <div data-dataset="real"><VariantB records={real} now={now} /></div>
      <div data-dataset="sample" hidden><VariantB records={sample} now={now} /></div>
    </div>
    <div data-variant="C" data-variant-name="极光与流星" hidden>
      <div data-dataset="real"><VariantC records={real} /></div>
      <div data-dataset="sample" hidden><VariantC records={sample} /></div>
    </div>
  </div>
</section>

<script>
  import './hero';
</script>

<style>
  .hero {
    margin: 0.5rem 0 2.5rem;
  }

  [data-prototype-variants] > [hidden],
  [data-dataset][hidden] {
    display: none;
  }
</style>
