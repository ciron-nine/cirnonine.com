---
/**
 * PROTOTYPE 变体 A：函数三维。Aizawa 吸引子，极细的单色线，缓慢自转，颗粒感像铅笔或网版印刷。
 * 静态后备是构建时画好的一张透明底 webp（浅色、深色各一张），WebGL 第一帧和它是同一个角度。
 */
---

<div class="frame" data-hero-frame>
  <picture class="still" aria-hidden="true">
    <source srcset="/home-hero-prototype/aizawa-dark.webp" media="(prefers-color-scheme: dark)" />
    <img src="/home-hero-prototype/aizawa-light.webp" alt="" width="900" height="900" decoding="async" />
  </picture>
</div>

<style>
  .frame {
    position: relative;
    aspect-ratio: 2 / 1;
    max-height: 72svh;
    overflow: hidden;
    color: var(--shell-fg);
  }

  @media (max-width: 640px) {
    .frame {
      aspect-ratio: 1;
    }
  }

  .still {
    position: absolute;
    inset: 0;
    display: flex;
    justify-content: center;
    transition: opacity 900ms ease;
  }

  .still img {
    height: 100%;
    width: auto;
    aspect-ratio: 1;
  }

  .frame :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 900ms ease;
  }

  .frame[data-gl='on'] :global(canvas) {
    opacity: 1;
  }

  .frame[data-gl='on'] .still {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .still,
    .frame :global(canvas) {
      transition: none;
    }
  }
</style>
