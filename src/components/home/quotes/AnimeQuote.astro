---
/** 首页摘录里动画的语录，像一帧画面下方的字幕：中文在上，日文原文小一号在下，白字黑边 */
import type { HomeQuote } from '../../../lib/home-data';

interface Props {
  quote: HomeQuote;
}
const { quote } = Astro.props;
---

<figure class="anime-quote">
  <blockquote>
    {quote.translation && <p class="translation voice">{quote.translation}</p>}
    <p class="original" lang={quote.lang}>{quote.original}</p>
  </blockquote>
  <figcaption>
    {quote.speaker && <span>{quote.speaker} — </span>}
    <a href={quote.record.href} lang={quote.record.lang}>{quote.record.originalTitle}</a>
    {quote.source && <span> {quote.source}</span>}
  </figcaption>
</figure>

<style>
  .anime-quote {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    max-width: 40rem;
    aspect-ratio: 16 / 9;
    margin: 0;
    padding: 1rem;
    color: #fff;
    background:
      radial-gradient(ellipse at 30% 30%, rgb(255 255 255 / 0.08), transparent 60%),
      #2b2b2b;
  }

  blockquote {
    margin: 0;
    text-align: center;
    text-shadow:
      0 0 2px #000,
      0 0 2px #000,
      1px 1px 0 #000,
      -1px -1px 0 #000,
      1px -1px 0 #000,
      -1px 1px 0 #000;
  }

  blockquote p {
    margin: 0;
  }

  .translation {
    font-size: clamp(1rem, 3.5vw, 1.375rem);
  }

  .original {
    font-size: clamp(0.75rem, 2.5vw, 0.9375rem);
    font-weight: 600;
  }

  figcaption {
    margin-top: 0.75rem;
    font-size: 0.75rem;
    color: rgb(255 255 255 / 0.55);
    text-align: right;
  }

  figcaption a {
    color: inherit;
  }

</style>
