---
/**
 * PROTOTYPE（首页第十五轮）编舞。一个类别是一支舞（一条闭合轨道），作品是舞里的星，在同一条轨道上互相追逐（见 dance.ts、choreo.ts）。
 * 第一屏只有这几支舞，叠在一起跳；没有别的字，只有每支舞的名字，和指着一颗星时左下角读出的名字。
 * 往下是名单：每支舞一栏，人多的那一栏折起来，点开看全部。
 * ?sample=many：编 6 个类别、从 1000 颗到 3 颗的示意数据，看类别多、多寡悬殊时是什么样子。
 */
---

<div class="ch" data-ch>
  <section class="stage" data-stage aria-label="编舞：每一条轨道是一个类别，轨道上追逐的星是这个类别里的作品">
    <canvas class="orbits" data-orbits aria-hidden="true"></canvas>
    <canvas class="stars" data-stars aria-hidden="true"></canvas>
    <div class="names" data-names></div>
    <p class="tip" data-tip aria-hidden="true"></p>
    <div class="now" aria-live="polite">
      <p class="title" data-title></p>
      <p class="sub" data-sub></p>
    </div>
  </section>
  <section class="roster" aria-label="名单">
    <div class="cols" data-roster></div>
  </section>
  <p class="sample-note" data-sample-note hidden>示意数据</p>
</div>

<style>
  .ch {
    --bg: #07070a;
    --ink: #ecebe6;
    --dim: color-mix(in srgb, var(--ink) 55%, var(--bg));
    --faint: color-mix(in srgb, var(--ink) 30%, var(--bg));
    --hair: color-mix(in srgb, var(--ink) 13%, var(--bg));

    color: var(--ink);
  }

  .ch::before {
    position: fixed;
    inset: 0;
    z-index: -1;
    content: '';
    background: var(--bg);
  }

  .stage {
    position: relative;
    width: 100vw;
    height: calc(100svh - 4rem);
    min-height: 32rem;
    margin-left: calc(50% - 50vw);
    overflow: hidden;
    touch-action: pan-y;
  }

  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .names {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .names :global(button) {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    gap: 0.7em;
    align-items: baseline;
    padding: 0.35rem 0.5rem;
    font: inherit;
    font-size: 0.8125rem;
    letter-spacing: 0.4em;
    color: var(--dim);
    white-space: nowrap;
    cursor: pointer;
    pointer-events: auto;
    background: none;
    border: 0;
    translate: -50% -50%;
    transition:
      color 0.3s,
      letter-spacing 0.4s,
      opacity 0.4s;
  }

  .names :global(button .n) {
    font-size: 0.6875rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
    color: var(--faint);
  }

  .names :global(button:hover),
  .names :global(button:focus-visible),
  .names :global(button[aria-pressed='true']) {
    color: var(--ink);
    letter-spacing: 0.55em;
    outline: none;
  }

  .names :global(button.away) {
    opacity: 0.35;
  }

  /* 指着的那颗星旁边的名字 */
  .tip {
    position: absolute;
    top: 0;
    left: 0;
    margin: 0;
    font-size: 0.875rem;
    color: #fff;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s;
    text-shadow: 0 0 10px #000, 0 0 3px #000;
  }

  .tip.on {
    opacity: 1;
  }

  .now {
    position: absolute;
    bottom: 1.75rem;
    left: max(clamp(1rem, 4vw, 2.5rem), env(safe-area-inset-left));
    max-width: 24rem;
    pointer-events: none;
  }

  .now p {
    margin: 0;
  }

  .now .title {
    font-size: 1.375rem;
    line-height: 1.3;
  }

  .now .sub {
    margin-top: 0.35rem !important;
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    color: var(--dim);
  }

  /* 名单 */
  .roster {
    padding: 12vh 0 14vh;
  }

  .cols {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 3rem clamp(2rem, 4vw, 4rem);
    align-items: start;
  }

  .cols :global(h2) {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 0.6rem;
    margin: 0 0 0.5rem;
    font-size: 1rem;
    font-weight: 400;
    border-bottom: 1px solid var(--hair);
  }

  .cols :global(h2 span) {
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    color: var(--dim);
  }

  .cols :global(ol) {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .cols :global(li) {
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
    padding: 0.28rem 0;
  }

  .cols :global(li i) {
    flex: none;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--c);
    translate: 0 -0.1em;
  }

  .cols :global(a) {
    color: var(--ink);
    text-decoration: none;
    transition: letter-spacing 0.35s;
  }

  .cols :global(li:hover a),
  .cols :global(a:focus-visible) {
    letter-spacing: 0.05em;
    outline: none;
  }

  .cols :global(.more) {
    padding: 0.6rem 0 0;
    font: inherit;
    font-size: 0.75rem;
    letter-spacing: 0.25em;
    color: var(--dim);
    cursor: pointer;
    background: none;
    border: 0;
  }

  .sample-note {
    position: fixed;
    right: 1rem;
    bottom: 4.25rem;
    z-index: 5;
    margin: 0;
    font-size: 0.75rem;
    color: var(--dim);
  }

  @media (max-width: 51.24rem) {
    .stage {
      height: 40rem;
    }

    .names :global(button) {
      letter-spacing: 0.2em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .names :global(button),
    .cols :global(a),
    .tip {
      transition: none;
    }
  }
</style>
