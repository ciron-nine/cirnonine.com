---
/**
 * PROTOTYPE（首页第八轮）A 遗忘曲线。设计模型是艾宾浩斯的 R = e^(−t/S)，见 forgetting.ts。
 * 整页是一张重写本：作品名用墨水一个接一个写下去，最新的在最上面。
 * - 每个名字按「过了多久」算出它还剩多少（R）：墨色从新鲜的蓝黑褪成铁胆墨老了以后的褐色，字也一点点散开
 * - 记得不准的日子（到月、到年、很久以前），字的边缘是虚的
 * - 文字栏的右边缘就是这条曲线：越久以前，留下的地方越窄
 * - 指着一个名字停一会儿，它会被想起来；离开后又慢慢淡回去，但比原来淡得慢一点
 * 字号比例取 e 的四分之一次方（≈1.284），往上数四级正好是 e。
 */
import type { HomeData } from '../../lib/home-data';

interface Props {
  data: HomeData;
}
const { data } = Astro.props;
const [hello, ...notes] = data.intro;
const titles = data.categories.flatMap((c) => c.records);
---

<div class="f" data-f>
  <header class="head">
    <p class="hello voice">{hello}</p>
    {notes.map((p) => <p class="note voice">{p}</p>)}
  </header>

  <div class="sheet" data-sheet>
    <div class="carve" data-carve aria-hidden="true"></div>
    <p class="text voice" data-text></p>
    <svg class="curve" data-curve aria-hidden="true"></svg>
    <p class="recall voice" data-recall aria-live="polite"></p>
    <p class="law">
      <span class="formula" aria-label="R 等于 e 的负 t 除以 S 次方">R = e<sup>−t/S</sup></span>
      <span class="voice">t 是过了多久，S 是记得有多牢。<br />心头好忘得慢一些；每被想起一次，也会慢一些。</span>
    </p>
  </div>

  <footer class="foot">
    <ul class="cats">
      {
        data.categories.map((c) => (
          <li>
            <a href={c.href}>{c.label}</a>
            <span>{c.records.length}</span>
          </li>
        ))
      }
    </ul>
  </footer>
  <p class="sample-note" data-sample-note hidden>示意日期</p>
  <!-- 让「我的声音」字体子集收到全部原名和日期里的字 -->
  <p hidden class="voice">
    {titles.map((r) => <span lang={r.lang}>{r.originalTitle}</span>)}0123456789年月日很久以前记得是哪一天只记得是哪个月只记得是哪一年记不清了想起来了次，
  </p>
</div>

<style>
  /* 墨水：新鲜的铁胆墨是蓝黑，放久了氧化成褐色；纸是冷一点的灰白，不是米黄 */
  .f {
    --vellum: #eceeec;
    --fresh: #1a1a33;
    --aged: #8f5f43;
    --ghost: color-mix(in srgb, var(--aged) 40%, var(--vellum));
    --e1: 1rem;
    --e2: calc(var(--e1) * 1.284);
    --e3: calc(var(--e2) * 1.284);
    --e4: calc(var(--e3) * 1.284);
    --e5: calc(var(--e4) * 1.284); /* = e rem */

    padding: 6vh 0 10vh;
    color: var(--fresh);
  }

  .f::before {
    position: fixed;
    inset: 0;
    z-index: -1;
    content: '';
    background: var(--vellum);
  }

  .head {
    max-width: 34rem;
    margin-bottom: 9vh;
    font-size: var(--e1);
    line-height: 2;
    color: var(--aged);
  }

  .head p {
    margin: 0 0 0.6em;
  }

  .hello {
    margin-bottom: 1rem !important;
    font-size: var(--e3);
    line-height: 1.4;
    color: var(--fresh);
  }

  .sheet {
    position: relative;
    display: flow-root;
  }

  /* 右边被遗忘挖掉的那一块：形状由脚本按曲线给出 */
  .carve {
    float: right;
    width: 100%;
    height: 0;
  }

  .text {
    margin: 0;
    font-size: var(--e4);
    line-height: 1.9;
    text-align: justify;
    text-justify: inter-character;
  }

  /* 一个名字。--r 是它此刻还剩多少（0..1），由脚本给出 --r0 */
  .text :global(.rec) {
    --r: var(--r0, 1);

    color: color-mix(in oklab, var(--fresh) calc(var(--r) * 100%), var(--aged));
    opacity: calc(0.34 + var(--r) * 0.66);
    filter: blur(calc(var(--blur, 0px) * (1 - var(--r))));
    outline: none;
    transition:
      --r 3.6s cubic-bezier(0.05, 0.7, 0.1, 1) var(--delay, 0s),
      text-decoration-color 0.4s;
    text-decoration: underline 1px transparent;
    text-underline-offset: 0.3em;
  }

  .text :global(.rec.fav) {
    font-weight: 700;
  }

  /* 想起来：很快变清楚 */
  .text :global(.rec.recalling) {
    --r: 1;

    text-decoration-color: color-mix(in srgb, var(--fresh) 40%, transparent);
    transition:
      --r 0.7s cubic-bezier(0.2, 0.8, 0.2, 1),
      text-decoration-color 0.4s;
  }

  .text :global(.rec:focus-visible) {
    text-decoration-color: var(--fresh);
  }

  .text :global(.sep) {
    margin: 0 0.35em;
    font-size: 0.42em;
    vertical-align: 0.3em;
    color: var(--ghost);
  }

  /* 曲线和年份 */
  .curve {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .curve :global(.line) {
    fill: none;
    stroke: var(--aged);
    stroke-width: 1;
    opacity: 0.55;
  }

  .curve :global(.floor) {
    stroke: var(--aged);
    stroke-dasharray: 1 6;
    opacity: 0.5;
  }

  .curve :global(.tick) {
    stroke: var(--aged);
    opacity: 0.55;
  }

  .curve :global(.yr) {
    font-size: 13px;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
    fill: var(--aged);
  }

  /* 想起来的时候，旁边用小字写出那是什么时候 */
  .recall {
    position: absolute;
    z-index: 2;
    margin: 0;
    font-size: 0.8125rem;
    color: var(--aged);
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.4s;
  }

  .recall.on {
    opacity: 1;
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem 4rem;
    justify-content: space-between;
    align-items: end;
    margin-top: 12vh;
    color: var(--aged);
  }

  /* 公式写在被遗忘挖掉的那块空白里 */
  .law {
    position: absolute;
    right: 0;
    bottom: 0;
    max-width: 24rem;
    display: grid;
    gap: 0.75rem;
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.9;
  }

  .formula {
    font-family: 'Times New Roman', Times, serif;
    font-size: var(--e3);
    font-style: italic;
    color: var(--fresh);
  }

  .formula sup {
    font-size: 0.55em;
  }

  .cats {
    display: flex;
    gap: 1.75rem;
    padding: 0;
    margin: 0;
    list-style: none;
    font-size: 0.875rem;
  }

  .cats a {
    color: var(--fresh);
    text-decoration: none;
    transition: letter-spacing 0.35s;
  }

  .cats a:hover,
  .cats a:focus-visible {
    letter-spacing: 0.12em;
  }

  .cats span {
    margin-left: 0.4rem;
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 47.99rem) {
    .law {
      position: static;
      margin-top: 4rem;
    }

    .text {
      font-size: var(--e3);
      line-height: 1.85;
    }

    .hello {
      font-size: var(--e2);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .text :global(.rec),
    .text :global(.rec.recalling) {
      transition: none;
    }
  }
</style>

<style is:global>
  /* 让 --r 能被过渡（遗忘和回想都是 --r 的变化） */
  @property --r {
    syntax: '<number>';
    inherits: true;
    initial-value: 1;
  }
</style>
