---
/**
 * PROTOTYPE（首页第八轮）B 光锥与世界线。设计模型是闵可夫斯基时空图，见 worldline.ts。
 * 竖直向上是时间，光走 45°。正中那条竖线是我的世界线，最上面一点是现在；
 * 现在的过去光锥从那里向下张开，整张图都在它里面。
 * 四个类别是四个方向。指着一件事，画出它的光锥：锥里的事可能因它而起，或让它发生；锥外的事只是同时在别处。
 * 记不清日子的事画成一段竖线，有多不准就有多长；很久以前的事没有日期，画不进图里，放在视界下面。
 */
import type { HomeData } from '../../lib/home-data';

interface Props {
  data: HomeData;
}
const { data } = Astro.props;
const [hello, ...notes] = data.intro;
const LANE: Record<string, string> = { games: '左二', 'visual-novels': '左一', anime: '右一', songs: '右二' };
---

<div class="w" data-w>
  <header class="head">
    <div class="intro voice">
      <p class="hello">{hello}</p>
      {notes.map((p) => <p>{p}</p>)}
    </div>
    <div class="key">
      <p>中间的竖线是我的世界线，往上是时间。一个点是一件记得日子的事；记不准的，画成一段竖线，有多不准就有多长。</p>
      <p>指着一件事，会画出它的光锥。锥里的事，可能因它而起，或者让它发生；锥外的，只是同时发生在别处。</p>
      <ul class="cats">
        {
          data.categories.map((c) => (
            <li data-lane={LANE[c.key]}>
              <a href={c.href}>{c.label}</a>
              <span>{c.records.length}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </header>

  <div class="diagram" data-diagram>
    <svg class="geo" data-geo aria-hidden="true"></svg>
    <ol class="events" data-events aria-label="记得日子的事，从近到远"></ol>
  </div>

  <section class="horizon" data-horizon>
    <h2 class="voice">很久以前</h2>
    <p class="why">说不清是什么时候的事，画不出光锥，只能放在图外。</p>
    <ul class="fog" data-fog></ul>
  </section>
  <p class="sample-note" data-sample-note hidden>示意日期</p>
</div>

<style>
  .w {
    --paper: #e7ebee;
    --ink: #10151f;
    --light: #e0952a;
    --dim: color-mix(in srgb, var(--ink) 55%, var(--paper));
    --faint: color-mix(in srgb, var(--ink) 30%, var(--paper));
    --hair: color-mix(in srgb, var(--ink) 12%, var(--paper));

    padding-bottom: 12vh;
    color: var(--ink);
  }

  .w::before {
    position: fixed;
    inset: 0;
    z-index: -1;
    content: '';
    background: var(--paper);
  }

  .head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 3rem clamp(2rem, 8vw, 8rem);
    max-width: 64rem;
    padding: 4vh 0 2vh;
    font-size: 0.9375rem;
    line-height: 2;
  }

  .head p {
    margin: 0 0 0.75em;
  }

  .hello {
    font-size: 1.75rem;
    line-height: 1.35;
  }

  .key {
    align-self: end;
    font-size: 0.8125rem;
    color: var(--dim);
  }

  .cats {
    display: flex;
    gap: 1.5rem;
    padding: 0;
    margin: 1rem 0 0;
    list-style: none;
  }

  .cats a {
    color: var(--ink);
    text-decoration: none;
    transition: letter-spacing 0.3s;
  }

  .cats a:hover,
  .cats a:focus-visible {
    letter-spacing: 0.15em;
  }

  .cats span {
    margin-left: 0.35rem;
    font-variant-numeric: tabular-nums;
  }

  /* ---------- 时空图 ---------- */
  .diagram {
    position: relative;
    margin: 0 calc(-1 * clamp(1rem, 4vw, 2.5rem));
    overflow: hidden;
  }

  .geo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .geo :global(.null) {
    stroke: var(--hair);
    stroke-width: 1;
  }

  .geo :global(.cone-now) {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1;
    opacity: 0.55;
  }

  .geo :global(.cone-now-label) {
    font-size: 12px;
    letter-spacing: 0.2em;
    fill: var(--dim);
  }

  .geo :global(.worldline) {
    stroke: var(--ink);
    stroke-width: 1.5;
  }

  .geo :global(.worldline-tail) {
    stroke: var(--ink);
    stroke-width: 1.5;
    stroke-dasharray: 1 5;
  }

  .geo :global(.year-tick) {
    stroke: var(--ink);
  }

  .geo :global(.year) {
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
    fill: var(--dim);
  }

  .geo :global(.lane-name) {
    font-size: 12px;
    letter-spacing: 0.3em;
    writing-mode: vertical-rl;
    fill: var(--dim);
  }

  .geo :global(.apex) {
    fill: var(--ink);
  }

  .geo :global(.now-label) {
    font-size: 13px;
    letter-spacing: 0.15em;
    fill: var(--ink);
  }

  .geo :global(.now-date) {
    font-size: 11px;
    font-variant-numeric: tabular-nums;
    fill: var(--dim);
  }

  .geo :global(.leader) {
    stroke: var(--faint);
    stroke-width: 0.75;
  }

  .geo :global(.series) {
    stroke: var(--ink);
    stroke-width: 0.75;
    stroke-dasharray: 3 4;
    opacity: 0.45;
  }

  .geo :global(.ev-dot) {
    fill: var(--ink);
  }

  .geo :global(.ev-bar) {
    stroke: var(--ink);
    stroke-width: 2.5;
    stroke-linecap: butt;
  }

  .geo :global(.ev-cap) {
    stroke: var(--ink);
    stroke-width: 1;
  }

  .geo :global(.ev-ring) {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1;
  }

  /* 指着一件事时：它的光锥 */
  .geo :global(.light) {
    fill: color-mix(in srgb, var(--light) 13%, transparent);
    stroke: var(--light);
    stroke-width: 1.25;
  }

  .geo :global(.ev) {
    transition: opacity 0.25s;
  }

  .diagram[data-lit] .geo :global(.ev.elsewhere),
  .diagram[data-lit] .geo :global(.leader.elsewhere),
  .diagram[data-lit] .geo :global(.series) {
    opacity: 0.18;
  }

  .geo :global(.ev.here .ev-dot),
  .geo :global(.ev.here .ev-ring) {
    fill: var(--light);
    stroke: var(--light);
  }

  .geo :global(.ev.here .ev-bar),
  .geo :global(.ev.here .ev-cap) {
    stroke: var(--light);
  }

  /* 名字：HTML，叠在图上 */
  .events {
    position: relative;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .events :global(li) {
    position: absolute;
    display: grid;
    width: max-content;
    max-width: var(--max);
    line-height: 1.35;
    transform: translateY(-50%);
    transition: opacity 0.25s;
  }

  .events :global(li.left) {
    text-align: right;
    transform: translate(-100%, -50%);
  }

  .events :global(a) {
    font-size: 0.875rem;
    color: var(--ink);
    text-decoration: none;
    outline: none;
  }

  .events :global(li.fav a) {
    font-weight: 700;
  }

  .events :global(.when) {
    max-height: 0;
    overflow: hidden;
    font-size: 0.6875rem;
    font-variant-numeric: tabular-nums;
    color: var(--dim);
    transition: max-height 0.25s;
  }

  .events :global(li.here .when) {
    max-height: 1.5em;
  }

  .events :global(li.here a) {
    text-decoration: underline 1px var(--light);
    text-underline-offset: 0.3em;
  }

  .diagram[data-lit] .events :global(li.elsewhere) {
    opacity: 0.28;
  }

  /* ---------- 很久以前：视界下面 ---------- */
  .horizon {
    position: relative;
    padding-top: 3rem;
    margin-top: 1rem;
    border-top: 1px dashed var(--faint);
  }

  .horizon h2 {
    margin: 0 0 0.25rem;
    font-size: 1.5rem;
    font-weight: 400;
    letter-spacing: 0.3em;
  }

  .why {
    margin: 0 0 2.5rem;
    font-size: 0.8125rem;
    color: var(--dim);
  }

  .fog {
    padding: 0;
    margin: 0;
    columns: 3 14rem;
    column-gap: 3rem;
    list-style: none;
  }

  .fog :global(li) {
    break-inside: avoid;
    padding: 0.2rem 0;
    font-size: 0.9375rem;
  }

  .fog :global(a) {
    color: var(--dim);
    text-decoration: none;
    transition:
      color 0.3s,
      letter-spacing 0.3s;
  }

  .fog :global(a:hover),
  .fog :global(a:focus-visible) {
    color: var(--ink);
    letter-spacing: 0.08em;
  }

  .fog :global(.g) {
    display: inline-block;
    width: 1.25rem;
    font-size: 0.625rem;
    color: var(--faint);
  }

  @media (max-width: 47.99rem) {
    .head {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }

    .hello {
      font-size: 1.375rem;
    }

    .events :global(a) {
      font-size: 0.8125rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .geo :global(.ev),
    .events :global(li),
    .events :global(.when) {
      transition: none;
    }
  }
</style>
