---
/**
 * PROTOTYPE（首页第五轮）C 极光与流星 · 极夜电影。
 * 整页是一部很短的片子：背后是极夜里的湖、山和极光（c-aurora.ts），小册子的五样东西是五个场景，
 * 每个场景一屏，字像字幕或片名卡一样压在画面上：
 * 片名（封面）→ 字幕（写在里面）→ 四个类别像星座名挂在天上（收录）→ 一句台词（摘录）→ 片尾字幕（最近完成）。
 * 往下滚动时镜头仰起来，地平线沉下去，片尾字幕滚在星空上。
 */
import type { HomeData } from '../home-hero-prototype/home-data';
import AvatarPlaceholder from '../home-hero-prototype/AvatarPlaceholder.astro';
import RandomQuote from '../home-hero-prototype/RandomQuote.astro';

interface Props {
  data: HomeData;
}
const { data } = Astro.props;
const [hello, ...notes] = data.intro;
const CATEGORY_LABEL = Object.fromEntries(data.categories.map((c) => [c.key, c.label]));
/** 四个类别在天上的位置（左、上，百分比），像星座名一样错落 */
const PLACES = [
  [10, 22],
  [52, 12],
  [24, 50],
  [64, 40],
];
---

<div class="c" data-c>
  <div class="c-film" aria-hidden="true"><canvas data-c-canvas></canvas></div>

  <section class="c-scene c-title" aria-label="封面" data-avatar-history>
    <p class="c-mark" translate="no">cirnonine</p>
    <div class="c-still">
      {
        data.avatars.map((avatar, i) => (
          <div class="c-slide" data-avatar-slide hidden={i > 0}>
            {avatar.from.record ? (
              <a href={avatar.from.record.href}>
                <AvatarPlaceholder avatar={avatar} />
              </a>
            ) : (
              <AvatarPlaceholder avatar={avatar} />
            )}
          </div>
        ))
      }
      <p class="c-steps">
        <button type="button" data-avatar-step="1" aria-label="往回翻一个头像">←</button>
        <button type="button" data-avatar-step="-1" aria-label="往后翻一个头像">→</button>
      </p>
    </div>
  </section>

  <section class="c-scene c-subs voice" aria-label="写在里面">
    <div class="c-sub-lines">
      <p class="c-sub" data-c-reveal>{hello}</p>
      {notes.map((p) => <p class="c-sub" data-c-reveal>{p}</p>)}
    </div>
  </section>

  <section class="c-scene c-sky" aria-labelledby="c-tracks">
    <h2 id="c-tracks" class="c-visually-hidden">收录</h2>
    <ul class="c-constellations">
      {
        data.categories.map((c, i) => (
          <li style={`left:${PLACES[i][0]}%;top:${PLACES[i][1]}%`} data-c-reveal>
            <a href={c.href}>
              <span class="c-name">{c.label}</span>
              <span class="c-count">{c.records.length} 部</span>
            </a>
            <p class="c-few">
              {c.records.slice(0, 3).map((r, k) => (
                <>
                  {k > 0 && <br />}
                  <a href={r.href} lang={r.lang}>
                    {r.originalTitle}
                  </a>
                </>
              ))}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="c-scene c-line" aria-label="摘录">
    <div data-c-reveal>
      <RandomQuote quotes={data.quotes} />
    </div>
  </section>

  <section class="c-scene c-credits" aria-labelledby="c-recent">
    <h2 id="c-recent" class="c-credits-h">最近完成</h2>
    <ol>
      {
        data.recent.map((r) => (
          <li data-c-reveal>
            <span class="c-role">{CATEGORY_LABEL[r.category]}</span>
            <a href={r.href} lang={r.lang}>
              {r.originalTitle}
            </a>
            <span class="c-when voice">{r.datetime ? <time datetime={r.datetime}>{r.dateLabel}</time> : r.dateLabel}</span>
          </li>
        ))
      }
    </ol>
    <p class="c-end voice">— c9</p>
  </section>
</div>

<style>
  .c {
    --c-ink: #eef3f6;
    --c-faint: rgb(238 243 246 / 0.6);

    color: var(--c-ink);
  }

  .c-film {
    position: fixed;
    inset: 0;
    z-index: -1;
    background: #03060c;
  }

  .c-film canvas {
    width: 100%;
    height: 100%;
  }

  .c a {
    color: inherit;
    text-decoration: none;
  }

  .c a:hover,
  .c a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .c-scene {
    position: relative;
    box-sizing: border-box;
    min-height: 100svh;
  }

  /* 片名：站名在湖面上方，很小的字距很宽；头像像一张定格的剧照 */
  .c-title {
    display: grid;
    align-content: end;
    justify-items: center;
    padding-bottom: 30svh;
  }

  .c-mark {
    margin: 0;
    font-size: clamp(1.5rem, 4vw, 2.75rem);
    letter-spacing: 0.5em;
    text-shadow: 0 0 30px rgb(80 255 160 / 0.35);
  }

  .c-still {
    position: absolute;
    top: 14svh;
    right: clamp(1rem, 7vw, 6rem);
    width: clamp(6rem, 13vw, 10rem);
    aspect-ratio: 4 / 5;
    border: 1px solid rgb(238 243 246 / 0.4);
    padding: 0.35rem 0.35rem 2.6rem;
    background: rgb(3 6 12 / 0.4);
  }

  .c-slide {
    position: absolute;
    inset: 0.35rem 0.35rem 2.6rem;
  }

  .c-slide[hidden] {
    display: none;
  }

  .c-slide a {
    display: block;
    height: 100%;
  }

  .c-still :global(.avatar) {
    width: 100%;
    height: 100%;
    aspect-ratio: auto !important;
    background: linear-gradient(170deg, #1d4a4a, #2b1f40) !important;
  }

  .c-steps {
    position: absolute;
    right: 0.2rem;
    bottom: 0.15rem;
    display: flex;
    margin: 0;
  }

  .c-steps button {
    min-width: 2.25rem;
    min-height: 2.25rem;
    font: inherit;
    color: var(--c-ink);
    cursor: pointer;
    background: none;
    border: 0;
  }

  .c-steps button:disabled {
    opacity: 0.25;
  }

  /* 字幕：下三分之一，居中，一句一行 */
  .c-subs {
    display: grid;
    align-content: end;
    justify-items: center;
    padding: 0 1rem 16svh;
  }

  .c-sub-lines {
    display: grid;
    gap: 1.1rem;
    max-width: 38rem;
    text-align: center;
  }

  .c-sub {
    margin: 0;
    font-size: clamp(1.0625rem, 1.8vw, 1.375rem);
    line-height: 1.8;
    text-shadow:
      0 1px 2px rgb(0 0 0 / 0.9),
      0 0 18px rgb(0 0 0 / 0.6);
  }

  .c-sub:first-child {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
  }

  /* 收录：四个类别像星座名挂在天上 */
  .c-constellations {
    position: absolute;
    inset: 8svh clamp(1rem, 5vw, 4rem) 8svh;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .c-constellations > li {
    position: absolute;
  }

  .c-constellations > li > a {
    display: flex;
    white-space: nowrap;
    gap: 0.75rem;
    align-items: baseline;
  }

  .c-name {
    font-size: clamp(1.75rem, 4.2vw, 3.5rem);
    letter-spacing: 0.35em;
    text-shadow: 0 0 24px rgb(120 255 190 / 0.3);
  }

  .c-count {
    font-size: 0.8125rem;
    color: var(--c-faint);
  }

  .c-few {
    margin: 0.5rem 0 0;
    font-size: 0.8125rem;
    line-height: 1.8;
    color: var(--c-faint);
  }

  /* 摘录：一句台词放在画面正中 */
  .c-line {
    display: grid;
    place-items: center;
    padding: 0 1rem;
  }

  /* 片尾字幕：居中滚过星空 */
  .c-credits {
    display: grid;
    justify-items: center;
    align-content: center;
    padding: 20svh 1rem 40svh;
    text-align: center;
  }

  .c-credits-h {
    margin: 0 0 3rem;
    font-size: 0.875rem;
    font-weight: 400;
    letter-spacing: 0.4em;
    color: var(--c-faint);
  }

  .c-credits ol {
    display: grid;
    gap: 2.25rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .c-credits li {
    display: grid;
    gap: 0.3rem;
  }

  .c-role,
  .c-when {
    font-size: 0.8125rem;
    color: var(--c-faint);
  }

  .c-credits li > a {
    font-size: clamp(1.25rem, 2.4vw, 1.75rem);
  }

  .c-end {
    margin: 5rem 0 0;
    color: var(--c-faint);
  }

  .c-visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* 字幕一句一句淡入（JS 跑起来、没开减少动态效果时） */
  .c[data-motion] [data-c-reveal] {
    opacity: 0;
    filter: blur(6px);
    transition:
      opacity 1.4s ease,
      filter 1.4s ease;
  }

  .c[data-motion] [data-c-reveal].in {
    opacity: 1;
    filter: none;
  }

  @media (max-width: 47.99rem) {
    .c-still {
      top: 10svh;
    }

    .c-constellations {
      position: static;
      display: grid;
      gap: 2.5rem;
      padding: 14svh 1.25rem;
    }

    .c-constellations > li {
      position: static;
    }
  }
</style>
