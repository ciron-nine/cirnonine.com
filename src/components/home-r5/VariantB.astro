---
/**
 * PROTOTYPE（首页第六轮）B 记录星图 · 印刷星图。
 * 整页是一张印在白纸上的天图：蓝色的赤经赤纬网，黑色的星。四个类别各是一个天区（阶梯状的星座边界），
 * 每条记录是一颗可以点的星：越近完成的越靠中心，心头好是红色的大星，同一系列连成星座。
 *
 * 记录多了怎么办（b-chart-data.ts）：星按黄金角均匀散开；名字分三个缩放级别各自避让，不会重叠，
 * 放不下的名字先不显示，放大以后才出来，像地图一样。星图可以滚轮缩放、拖动，点类别名缩放到那个天区。
 * 动起来：打开时星按完成的先后一颗颗印上去、星座线随后连起来；暗星闪；偶尔一颗流星划过；
 * 指一颗星时它的系列亮起来、星表里那一行也亮；指星表里的一行，星图上那颗星亮。鼠标处有准星读坐标。
 * 右边一页是星表，也就是小册子：封面（底片）、写在里面（序）、收录（图例）、最近完成（星表）、摘录（脚注）。
 *
 * sample：B2 用的示意数据（造这么多条假记录），看堆满以后的样子。
 */
import type { HomeData } from '../home-hero-prototype/home-data';
import AvatarPlaceholder from '../home-hero-prototype/AvatarPlaceholder.astro';
import RandomQuote from '../home-hero-prototype/RandomQuote.astro';
import { C, DISC, LEVELS, chart } from './b-chart-data';

interface Props {
  data: HomeData;
  sample?: number;
}
const { data, sample = 0 } = Astro.props;
const uid = sample ? 'b2' : 'b';
const [hello, ...notes] = data.intro;
const CATEGORY_LABEL = Object.fromEntries(data.categories.map((c) => [c.key, c.label]));

const { stars, lines, field, boundary, regions, total } = chart(data, sample);
const hours = Array.from({ length: 24 }, (_, h) => h);
/** 印上去的总时长（毫秒），记录越多每颗越快 */
const INK_MS = 2600;
const inkDelay = (order: number) => Math.round((order / Math.max(total, 1)) * INK_MS);
---

<div class="b" data-b>
  <div class="b-chart-wrap">
    <svg class="b-chart" viewBox="0 0 1000 1000" role="img" aria-label={`记录星图：${total} 条记录，每条是一颗星`} data-b-chart data-lod="1" style="--z: 1">
      <defs>
        <clipPath id={`${uid}-disc`}><circle cx={C} cy={C} r={DISC} /></clipPath>
      </defs>
      <g class="b-sky" clip-path={`url(#${uid}-disc)`}>
        <rect x="0" y="0" width="1000" height="1000" class="b-drag" />
        <g class="b-grid">
          {[1, 2, 3, 4, 5, 6, 7, 8].map((i) => <circle cx={C} cy={C} r={i * 60} />)}
          {hours.map((h) => (
            <line x1={C} y1={C} x2={C + Math.cos((h * 15 * Math.PI) / 180) * DISC} y2={C + Math.sin((h * 15 * Math.PI) / 180) * DISC} />
          ))}
        </g>
        <g class="b-bounds">{[0, 90, 180, 270].map((d) => <path d={boundary(d)} />)}</g>
        <g class="b-field">
          {field.map((f) => (
            <circle cx={f.x.toFixed(1)} cy={f.y.toFixed(1)} r={f.s.toFixed(2)} class:list={{ tw: f.twinkle }} style={f.twinkle ? `--tw:${f.delay.toFixed(2)}s` : undefined} />
          ))}
        </g>
        <g class="b-lines">
          {lines.map(({ a, b, series }) => {
            const len = Math.hypot(b.x - a.x, b.y - a.y);
            return (
              <line x1={a.x} y1={a.y} x2={b.x} y2={b.y} data-series={series} style={`--len:${len.toFixed(1)};--d:${inkDelay(b.order) + 300}ms`} />
            );
          })}
        </g>
        <g class="b-regions">
          {
            regions.map((r) => (
              <text x={r.x} y={r.y} text-anchor="middle" data-zoom-to={`${r.fx},${r.fy}`} role="button" tabindex="0" aria-label={`放大到${r.label}天区`}>
                {r.label}
              </text>
            ))
          }
        </g>
        <path class="b-meteor" data-b-meteor d="M0 0" />
        <g class="b-stars">
          {
            stars.map((s) => {
              const Tag = s.rec.href ? 'a' : 'g';
              return (
                <Tag
                  href={s.rec.href}
                  class:list={['b-star', { fav: s.rec.favorite }]}
                  aria-label={s.rec.href ? s.rec.title : undefined}
                  data-key={s.rec.key}
                  data-title={s.rec.title}
                  data-series={s.rec.series}
                  style={`--d:${inkDelay(s.order)}ms`}
                >
                  <circle cx={s.x} cy={s.y} r={s.size + 6} class="b-hit" style={`--r:${(s.size + 6).toFixed(2)}`} />
                  {s.rec.favorite && <circle cx={s.x} cy={s.y} r={s.size + 3.5} class="b-ring" style={`--r:${(s.size + 3.5).toFixed(2)}`} />}
                  <circle cx={s.x} cy={s.y} r={s.size} class="b-dot" style={`--r:${s.size.toFixed(2)}`} />
                  {LEVELS.map((level) => {
                    const l = s.labels[level];
                    return l ? (
                      <text x={l.x.toFixed(1)} y={l.y.toFixed(1)} text-anchor={l.anchor} class={`l${level}`} lang={s.rec.lang} aria-hidden="true">
                        {s.rec.title}
                      </text>
                    ) : null;
                  })}
                </Tag>
              );
            })
          }
        </g>
      </g>
      <circle cx={C} cy={C} r={DISC} class="b-rim" />
      <g class="b-hours" aria-hidden="true">
        {
          hours.map((h) => (
            <text x={C + Math.cos((h * 15 * Math.PI) / 180) * 494} y={C + Math.sin((h * 15 * Math.PI) / 180) * 494 + 3} text-anchor="middle">
              {h}h
            </text>
          ))
        }
      </g>
      <g class="b-reticle" data-b-reticle aria-hidden="true">
        <circle r="26" />
        <line x1="-40" x2="-14" />
        <line x1="14" x2="40" />
        <line y1="-40" y2="-14" />
        <line y1="14" y2="40" />
        <text x="32" y="-30" data-b-coord></text>
      </g>
    </svg>
    <div class="b-zoom" role="group" aria-label="缩放星图">
      <button type="button" data-zoom="in" aria-label="放大">＋</button>
      <button type="button" data-zoom="out" aria-label="缩小">－</button>
      <button type="button" data-zoom="reset" aria-label="看全图">全图</button>
    </div>
    {sample > 0 && <p class="b-sample">示意：{total} 条假记录</p>}
  </div>

  <aside class="b-sheet" aria-label="星表">
    <section class="b-plate" aria-label="封面" data-avatar-history>
      <div class="b-plate-img">
        {
          data.avatars.map((avatar, i) => (
            <div class="b-slide" data-avatar-slide hidden={i > 0}>
              {avatar.from.record ? (
                <a href={avatar.from.record.href}>
                  <AvatarPlaceholder avatar={avatar} />
                </a>
              ) : (
                <AvatarPlaceholder avatar={avatar} />
              )}
            </div>
          ))
        }
      </div>
      <p class="b-steps">
        <button type="button" data-avatar-step="1" aria-label="往回翻一个头像">←</button>
        <button type="button" data-avatar-step="-1" aria-label="往后翻一个头像">→</button>
      </p>
    </section>

    <section class="b-preface voice" aria-label="写在里面">
      <p class="b-hello">{hello}</p>
      {notes.map((p) => <p>{p}</p>)}
    </section>

    <section aria-labelledby={`${uid}-legend`}>
      <h2 id={`${uid}-legend`} class="b-h">收录</h2>
      <ul class="b-legend">
        {
          regions.map((r) => (
            <li>
              <a href={r.href}>{r.label}</a>
              <button type="button" class="b-focus" data-zoom-to={`${r.fx},${r.fy}`} aria-label={`在星图上看${r.label}`}>
                {r.count}
              </button>
            </li>
          ))
        }
        <li class="b-key"><span class="b-key-dot fav" aria-hidden="true" />心头好</li>
        <li class="b-key"><span class="b-key-line" aria-hidden="true" />同一系列</li>
      </ul>
    </section>

    <section aria-labelledby={`${uid}-recent`}>
      <h2 id={`${uid}-recent`} class="b-h">最近完成</h2>
      <table class="b-table">
        <tbody>
          {
            data.recent.map((r) => (
              <tr data-key={`${r.category}/${r.slug}`}>
                <td class="b-cat">{CATEGORY_LABEL[r.category]}</td>
                <td>
                  <a href={r.href} lang={r.lang}>
                    {r.originalTitle}
                  </a>
                </td>
                <td class="b-date voice">{r.datetime ? <time datetime={r.datetime}>{r.dateLabel}</time> : r.dateLabel}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>

    <section class="b-note" aria-labelledby={`${uid}-quote`}>
      <h2 id={`${uid}-quote`} class="b-h">摘录</h2>
      <RandomQuote quotes={data.quotes} />
    </section>
  </aside>
</div>

<style>
  .b {
    --b-paper: #f3f5f8;
    --b-ink: #0f1420;
    --b-faint: #5d6678;
    --b-grid: #2f64b0;
    --b-red: #c8323e;

    display: grid;
    grid-template-columns: minmax(0, 1fr) 22rem;
    gap: 2rem;
    align-items: start;
    min-height: 100svh;
    color: var(--b-ink);
  }

  .b-chart-wrap {
    position: sticky;
    touch-action: none;
    top: 0;
    display: grid;
    place-items: center;
    height: calc(100svh - 4rem);
  }

  /* 白纸铺满整个视口，盖住外壳原来的底色 */
  .b::before {
    position: fixed;
    inset: 0;
    z-index: -1;
    content: '';
    background: var(--b-paper);
  }

  .b-chart {
    width: min(100%, calc(100svh - 5rem));
    height: auto;
    /* 放大以后星图不能画到框外面去 */
    overflow: hidden;
  }

  /* 星图缓慢摆动 */
  .b-sky {
    transform-origin: 500px 500px;
    animation: b-sway 90s ease-in-out infinite alternate;
  }

  @keyframes b-sway {
    from {
      transform: rotate(-4deg);
    }
    to {
      transform: rotate(5deg);
    }
  }

  .b-grid circle,
  .b-grid line {
    fill: none;
    stroke: var(--b-grid);
    stroke-width: 0.6;
    opacity: 0.32;
  }

  .b-bounds path {
    fill: none;
    stroke: var(--b-grid);
    stroke-width: 1;
    stroke-dasharray: 5 4;
    opacity: 0.7;
  }

  .b-field circle {
    fill: var(--b-ink);
    opacity: 0.55;
  }

  .b-lines line {
    stroke: var(--b-ink);
    stroke-width: 0.9;
    opacity: 0.55;
  }

  .b-regions text {
    font-size: 30px;
    /* 一圈纸色描边：星点压在上面时也读得出来 */
    stroke: var(--b-paper);
    stroke-width: 7px;
    paint-order: stroke;
    letter-spacing: 0.6em;
    fill: var(--b-grid);
    opacity: 0.55;
  }

  .b-hit {
    fill: transparent;
  }

  /* 放大时星点只按倍数的平方根变大（--zs 由脚本给），不会大成一个个黑饼 */
  .b-hit,
  .b-ring,
  .b-dot {
    r: calc(var(--r) * 1px / var(--zs, 1));
  }

  .b-dot {
    fill: var(--b-ink);
  }

  .b-star.fav .b-dot {
    fill: var(--b-red);
  }

  .b-ring {
    fill: none;
    stroke: var(--b-red);
    stroke-width: 1;
  }

  /* 名字：只显示当前缩放级别算好的那一份；字号跟着缩放变小，屏幕上看起来一样大 */
  .b-star text {
    display: none;
    font-size: calc(11px / var(--z));
    fill: var(--b-ink);
    opacity: 0.6;
  }

  .b-chart[data-lod='1'] .l1,
  .b-chart[data-lod='2'] .l2,
  .b-chart[data-lod='4'] .l4 {
    display: inline;
  }

  .b-star:hover text,
  .b-star:focus-visible text,
  .b-star.lit text {
    opacity: 1;
  }

  .b-star:hover .b-dot,
  .b-star:focus-visible .b-dot,
  .b-star.lit .b-dot {
    fill: var(--b-red);
    stroke: var(--b-paper);
    stroke-width: 2;
    paint-order: stroke;
  }

  .b-lines line.lit {
    stroke: var(--b-red);
    stroke-width: 1.6;
    opacity: 1;
  }

  .b-table tr.lit {
    background: rgb(200 50 62 / 0.08);
  }

  .b-drag {
    fill: transparent;
    cursor: grab;
  }

  .b-chart.dragging .b-drag {
    cursor: grabbing;
  }

  .b-regions text {
    cursor: zoom-in;
  }

  .b-regions text:hover,
  .b-regions text:focus-visible {
    opacity: 0.9;
    outline: none;
  }

  /* 流星：印刷星图上的一道虚线，划过去以后淡掉 */
  .b-meteor {
    fill: none;
    stroke: var(--b-ink);
    stroke-width: 1.2;
    stroke-linecap: round;
    opacity: 0;
  }

  .b-meteor.fly {
    stroke-dasharray: 220;
    stroke-dashoffset: 220;
    animation: b-meteor 1.6s ease-out forwards;
  }

  @keyframes b-meteor {
    10% {
      opacity: 0.85;
    }
    60% {
      stroke-dashoffset: 0;
      opacity: 0.85;
    }
    100% {
      stroke-dashoffset: -220;
      opacity: 0;
    }
  }

  /* 打开时星按完成的先后一颗颗印上去，星座线随后连起来 */
  .b[data-motion] .b-star {
    transform-box: fill-box;
    transform-origin: center;
    animation: b-ink 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) var(--d) both;
  }

  @keyframes b-ink {
    from {
      opacity: 0;
      transform: scale(2.4);
    }
  }

  .b[data-motion] .b-lines line {
    stroke-dasharray: var(--len);
    stroke-dashoffset: var(--len);
    animation: b-draw 0.9s ease var(--d) forwards;
  }

  @keyframes b-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  /* 暗星闪 */
  .b[data-motion] .b-field .tw {
    animation: b-twinkle 3.6s ease-in-out var(--tw) infinite alternate;
  }

  @keyframes b-twinkle {
    to {
      opacity: 0.12;
    }
  }

  /* 放大时星图不再摆，免得字在动 */
  .b-chart:not([data-lod='1']) .b-sky {
    animation-play-state: paused;
  }

  .b-zoom {
    position: absolute;
    bottom: 1rem;
    left: 0;
    display: flex;
    gap: 0.25rem;
  }

  .b-zoom button,
  .b-focus {
    min-width: 2.25rem;
    min-height: 2.25rem;
    padding: 0 0.6rem;
    font: inherit;
    font-size: 0.8125rem;
    color: var(--b-ink);
    cursor: pointer;
    background: #fff;
    border: 1px solid rgb(15 20 32 / 0.2);
  }

  .b-focus {
    min-height: 1.75rem;
    font-variant-numeric: tabular-nums;
    color: var(--b-faint);
    cursor: zoom-in;
    border-color: transparent;
  }

  .b-focus:hover {
    border-color: rgb(15 20 32 / 0.2);
  }

  .b-sample {
    position: absolute;
    right: 0;
    bottom: 1rem;
    margin: 0;
    font-size: 0.8125rem;
    color: var(--b-red);
  }

  .b-star:focus-visible {
    outline: none;
  }

  .b-star:focus-visible .b-hit {
    stroke: var(--b-red);
    stroke-width: 1.5;
  }

  .b-rim {
    fill: none;
    stroke: var(--b-ink);
    stroke-width: 1.4;
  }

  .b-hours text {
    font-size: 10px;
    fill: var(--b-grid);
  }

  .b-reticle {
    pointer-events: none;
    opacity: 0;
    transition: opacity 200ms;
  }

  .b-reticle.on {
    opacity: 1;
  }

  .b-reticle circle,
  .b-reticle line {
    fill: none;
    stroke: var(--b-red);
    stroke-width: 1.1;
  }

  .b-reticle text {
    font-size: 11px;
    font-variant-numeric: tabular-nums;
    fill: var(--b-red);
  }

  /* 星表：右边一页白纸 */
  .b-sheet {
    display: grid;
    gap: 2.75rem;
    padding: 2rem 1.75rem 5rem;
    margin-bottom: 3rem;
    font-size: 0.9375rem;
    background: #fff;
    box-shadow:
      0 1px 2px rgb(15 20 32 / 0.08),
      0 18px 40px -18px rgb(15 20 32 / 0.3);
  }

  .b-sheet a {
    color: inherit;
    text-decoration: none;
  }

  .b-sheet a:hover,
  .b-sheet a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .b-h {
    margin: 0 0 0.75rem;
    padding-bottom: 0.4rem;
    font-size: 0.9375rem;
    border-bottom: 1px solid var(--b-ink);
  }

  .b-plate {
    display: flex;
    gap: 0.75rem;
    align-items: end;
  }

  /* 头像像一张天文底片：黑底、反相的灰 */
  .b-plate-img {
    position: relative;
    width: 8.5rem;
    aspect-ratio: 1;
    border: 6px solid var(--b-ink);
  }

  .b-slide {
    position: absolute;
    inset: 0;
  }

  .b-slide[hidden] {
    display: none;
  }

  .b-slide a {
    display: block;
    height: 100%;
  }

  .b-plate :global(.avatar) {
    width: 100%;
    height: 100%;
    filter: grayscale(1) contrast(1.2);
  }

  .b-steps {
    display: flex;
    gap: 0.25rem;
    margin: 0;
  }

  .b-steps button {
    min-width: 2.25rem;
    min-height: 2.25rem;
    font: inherit;
    color: var(--b-ink);
    cursor: pointer;
    background: none;
    border: 1px solid rgb(15 20 32 / 0.25);
  }

  .b-steps button:disabled {
    opacity: 0.3;
  }

  .b-preface {
    font-size: 1rem;
    line-height: 1.9;
  }

  .b-preface p {
    margin: 0 0 0.8em;
  }

  .b-hello {
    font-size: 1.5rem;
    line-height: 1.35;
  }

  .b-legend {
    display: grid;
    gap: 0.45rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .b-legend li {
    display: flex;
    justify-content: space-between;
  }

  .b-legend li > a {
    font-size: 1.125rem;
  }

  .b-n {
    font-variant-numeric: tabular-nums;
    color: var(--b-faint);
  }

  .b-key {
    justify-content: flex-start !important;
    gap: 0.6rem;
    align-items: center;
    font-size: 0.8125rem;
    color: var(--b-faint);
  }

  .b-key-dot {
    width: 9px;
    height: 9px;
    background: var(--b-red);
    border-radius: 50%;
    box-shadow:
      0 0 0 2px #fff,
      0 0 0 3px var(--b-red);
  }

  .b-key-line {
    width: 1.5rem;
    border-top: 1px solid var(--b-ink);
  }

  .b-table {
    width: 100%;
    font-size: 0.875rem;
    border-collapse: collapse;
  }

  .b-table td {
    padding: 0.45rem 0.5rem 0.45rem 0;
    vertical-align: baseline;
    border-bottom: 1px solid rgb(15 20 32 / 0.12);
  }

  .b-cat,
  .b-date {
    color: var(--b-faint);
    white-space: nowrap;
  }

  .b-date {
    text-align: right;
  }

  @media (max-width: 47.99rem) {
    .b {
      grid-template-columns: minmax(0, 1fr);
    }

    .b-chart-wrap {
      position: relative;
      height: auto;
      padding: 0.5rem 0 1rem;
    }

    .b-chart {
      width: 100%;
    }

    .b-zoom,
    .b-sample {
      position: static;
      margin-top: 0.5rem;
    }

    /* 手机上 1× 的字太小：只留心头好的名字，放大以后其他名字才出来 */
    .b-chart[data-lod='1'] .b-star:not(.fav) .l1 {
      display: none;
    }

    .b-sheet {
      padding: 1.5rem 1.25rem 4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .b-sky {
      animation: none;
    }

    .b-meteor {
      display: none;
    }
  }
</style>
