---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { coverColor } from '../../lib/cover-color';
import { detailPage } from '../../lib/detail-page';
import { originalTitleLang } from '../../lib/original-title';
import RecordDate from '../voice/RecordDate.astro';
import Favorite from '../voice/Favorite.astro';
import ShortReview from '../voice/ShortReview.astro';

interface Props {
  novel: CollectionEntry<'visual-novels'>;
  /** 单独出现时是 h2，在一摞里时是 h3（摞的标题是 h2） */
  heading: 'h2' | 'h3';
}

const { novel, heading: Heading } = Astro.props;
const { data } = novel;
const href = detailPage(novel)?.href;
const color = data.cover && (await coverColor(data.cover));
---

<article style={color ? `--cover-color: ${color}` : undefined}>
  {data.cover && <Image src={data.cover} alt="" width={120} />}
  <Heading lang={originalTitleLang(data)}>{href ? <a href={href}>{data.originalTitle}</a> : data.originalTitle}</Heading>
  {data.translatedTitle && <p>{data.translatedTitle}</p>}
  <dl>
    <dt>品牌</dt>
    <dd>{data.brand}</dd>
    {
      data.writers.length > 0 && (
        <>
          <dt>剧本</dt>
          <dd>{data.writers.join('、')}</dd>
        </>
      )
    }
    {
      data.routes.length > 0 && (
        <>
          <dt>完成的路线</dt>
          <dd>{data.routes.join('、')}</dd>
        </>
      )
    }
  </dl>
  <RecordDate date={data.completed} />
  {data.favorite && <Favorite />}
  {data.shortReview && <ShortReview text={data.shortReview} />}
</article>
