---
/**
 * PROTOTYPE（首页第七轮）A 活动星盘。整页是一只转动的星盘，见 a-planisphere.ts。
 * 版面：盘面偏右、出血到屏幕外；右上读出指针对准的日期和「这一天前后」；左下是自我介绍和四种星形的图例。
 */
import type { HomeData } from '../../lib/home-data';

interface Props {
  data: HomeData;
}
const { data } = Astro.props;
const [hello, ...notes] = data.intro;
const GLYPH: Record<string, string> = { games: '●', 'visual-novels': '◆', anime: '○', songs: '✦' };
---

<div class="a" data-a>
  <svg class="wheel-svg" viewBox="-520 -520 1040 1040" data-wheel role="group" aria-label="活动星盘：转动它，看一年里不同的日子完成过什么" tabindex="0"></svg>

  <section class="read" aria-live="polite">
    <p class="caps">指针对准</p>
    <p class="read-date" data-read-date>1 · 1</p>
    <p class="caps">这一天前后，不同的年份</p>
    <ol class="read-list" data-read-list></ol>
  </section>

  <section class="intro">
    <p class="hello voice">{hello}</p>
    {notes.map((p) => <p class="voice">{p}</p>)}
    <ul class="legend">
      {
        data.categories.map((c) => (
          <li>
            <span class="g" aria-hidden="true">{GLYPH[c.key]}</span>
            <a class="caps" href={c.href}>{c.label}</a>
            <span class="n">{c.records.length}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <p class="turn">
    <button type="button" data-turn="prev">上个月</button>
    <button type="button" data-turn="today">今天</button>
    <button type="button" data-turn="next">下个月</button>
  </p>
  <p class="sample-note" data-sample-note hidden>示意日期</p>
  <p class="glyph-text voice" hidden>0123456789年月日很久以前这几天前后，还没有记下什么。</p>
</div>

<style>
  .a {
    position: relative;
    min-height: calc(100svh - 4rem);
    overflow: hidden;
  }

  /* 盘面：偏右、出血 */
  .wheel-svg {
    position: absolute;
    top: 50%;
    left: 58%;
    width: min(150vh, 120vw);
    height: auto;
    transform: translate(-50%, -50%);
    cursor: grab;
    touch-action: none;
  }

  .wheel-svg:active {
    cursor: grabbing;
  }

  .wheel-svg:focus-visible {
    outline: none;
  }

  .wheel-svg :global(.disc) {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.2;
  }

  .wheel-svg :global(.rule) {
    fill: none;
    stroke: var(--hair);
  }

  .wheel-svg :global(.tick) {
    stroke: var(--faint);
    stroke-width: 0.6;
  }

  .wheel-svg :global(.tick.month) {
    stroke: var(--ink);
    stroke-width: 0.9;
  }

  .wheel-svg :global(.month-name) {
    font-size: 15px;
    letter-spacing: 0.5em;
    fill: var(--ink);
  }

  .wheel-svg :global(.year-ring) {
    fill: none;
    stroke: var(--hair);
    stroke-dasharray: 1 5;
  }

  .wheel-svg :global(.hub) {
    fill: color-mix(in srgb, var(--ink) 6%, var(--paper));
    stroke: var(--faint);
    stroke-dasharray: 1 3;
  }

  .wheel-svg :global(.hub-name) {
    font-size: 13px;
    letter-spacing: 0.6em;
    fill: var(--dim);
  }

  .wheel-svg :global(.faded) {
    opacity: 0.45;
  }

  /* 记不清的那段时间：沿圈拖一段渐淡的弧 */
  .wheel-svg :global(.smear) {
    fill: none;
    stroke: var(--ink);
    stroke-linecap: round;
    opacity: 0.22;
  }

  .wheel-svg :global(.smear.month) {
    stroke-width: 4;
  }

  .wheel-svg :global(.smear.year) {
    stroke-width: 1.5;
    stroke-dasharray: 1 4;
    opacity: 0.4;
  }

  .wheel-svg :global(.star.lit .glyph circle),
  .wheel-svg :global(.star.lit .glyph path) {
    fill: var(--accent);
  }

  .wheel-svg :global(.star.lit .smear) {
    stroke: var(--accent);
    opacity: 0.5;
  }

  .wheel-svg :global(.pointer) {
    stroke: var(--accent);
    stroke-width: 1.2;
  }

  .wheel-svg :global(.pointer-dot),
  .wheel-svg :global(.rivet) {
    fill: var(--accent);
  }

  .wheel-svg :global(.year-label) {
    font-size: 13px;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.12em;
    fill: var(--accent);
  }

  /* 压在盘面上的字：一圈纸色的晕，像地图上的地名，不用卡片 */
  .read,
  .intro,
  .turn {
    text-shadow:
      0 0 3px var(--paper),
      0 0 6px var(--paper),
      0 0 12px var(--paper);
  }

  /* 读数：指针对准的日期 */
  .read {
    position: absolute;
    top: 2rem;
    right: clamp(1rem, 4vw, 3rem);
    z-index: 2;
    width: min(20rem, 40vw);
    text-align: right;
  }

  .read p {
    margin: 0;
  }

  .read-date {
    margin: 0.25rem 0 1.25rem !important;
    font-size: var(--t5);
    font-variant-numeric: tabular-nums;
    line-height: 1;
    letter-spacing: 0.02em;
  }

  .read-list {
    display: grid;
    gap: 0.6rem;
    padding: 0;
    margin: 0.75rem 0 0;
    list-style: none;
  }

  .read-list :global(li) {
    display: grid;
    gap: 0.1rem;
  }

  .read-list :global(.when) {
    font-size: var(--micro);
    color: var(--accent);
  }

  .read-list :global(a) {
    font-size: var(--t1);
  }

  .read-list :global(.empty) {
    color: var(--dim);
  }

  /* 左下：自我介绍和图例 */
  .intro {
    position: absolute;
    bottom: 2rem;
    left: clamp(1rem, 4vw, 3rem);
    z-index: 2;
    width: min(22rem, 34vw);
    font-size: var(--t0);
    line-height: 1.9;
  }

  .intro p {
    margin: 0 0 0.7em;
  }

  .hello {
    font-size: var(--t2);
    line-height: 1.3;
  }

  .legend {
    display: grid;
    gap: 0.35rem;
    padding: 1rem 0 0;
    margin: 1rem 0 0;
    list-style: none;
    border-top: 1px solid var(--hair);
  }

  .legend li {
    display: grid;
    grid-template-columns: 1.25rem 1fr auto;
    align-items: baseline;
  }

  .g {
    font-size: 0.8rem;
  }

  .n {
    font-size: var(--micro);
    font-variant-numeric: tabular-nums;
    color: var(--dim);
  }

  .turn {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    z-index: 2;
    display: flex;
    gap: 1.5rem;
    margin: 0;
    transform: translateX(-50%);
  }

  .turn button {
    padding: 0.5rem 0;
    font: inherit;
    font-size: var(--micro);
    letter-spacing: 0.3em;
    color: var(--dim);
    cursor: pointer;
    background: none;
    border: 0;
    border-bottom: 1px solid transparent;
    transition: letter-spacing 0.35s;
  }

  .turn button:hover,
  .turn button:focus-visible {
    color: var(--ink);
    letter-spacing: 0.4em;
    border-bottom-color: var(--accent);
    outline: none;
  }

  @media (max-width: 47.99rem) {
    .a {
      min-height: auto;
      padding-bottom: 2rem;
      overflow: visible;
    }

    .wheel-svg {
      position: relative;
      top: auto;
      left: 50%;
      width: 150vw;
      margin: -12vw 0 -20vw;
      transform: translateX(-50%);
    }

    .read,
    .intro,
    .turn {
      position: static;
      width: auto;
      transform: none;
    }

    .read {
      text-align: left;
      margin-bottom: 2rem;
    }

    .turn {
      justify-content: center;
      margin: 0 0 2rem;
    }
  }
</style>
