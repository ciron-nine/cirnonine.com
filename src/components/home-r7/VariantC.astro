---
/**
 * PROTOTYPE（首页第七轮）C 回望。往下滚就是往回看：一年一层，越往下越早、越暗，最底下是「很久以前」。见 c-lookback.ts。
 */
import type { HomeData } from '../../lib/home-data';

interface Props {
  data: HomeData;
}
const { data } = Astro.props;
const [hello, ...notes] = data.intro;
---

<div class="c" data-c>
  <header class="now">
    <p class="caps">现在</p>
    <p class="hello voice">{hello}</p>
    {notes.map((p) => <p class="voice">{p}</p>)}
    <p class="how caps">越往下，越久以前</p>
    <ul class="cats">
      {data.categories.map((c) => <li><a class="caps" href={c.href}>{c.label}</a><span>{c.records.length}</span></li>)}
    </ul>
  </header>
  <div class="layers" data-layers></div>
  <nav class="rail" aria-label="年份"><ol data-rail></ol></nav>
  <p class="sample-note" data-sample-note hidden>示意日期</p>
  <p hidden class="voice">0123456789年月日很久以前</p>
</div>

<style>
  /* 越往下越暗：--depth 由脚本按滚动给出，0 是白纸，1 是夜 */
  .c {
    --depth: 0;
    --night: #0b0d12;
    --pct: calc(var(--depth) * 100%);
    --bg: color-mix(in srgb, var(--night) var(--pct), var(--paper));
    --fg: color-mix(in srgb, var(--paper) var(--pct), var(--ink));

    position: relative;
    overflow-x: clip;
    color: var(--fg);
  }

  .c::after {
    position: fixed;
    inset: 0;
    z-index: -1;
    content: '';
    background: var(--bg);
  }

  .now {
    display: grid;
    align-content: end;
    max-width: 36rem;
    min-height: calc(100svh - 5rem);
    padding-bottom: 14vh;
    font-size: var(--t0);
    line-height: 2;
  }

  .now p {
    margin: 0 0 0.8em;
  }

  .hello {
    margin-top: 0.5rem !important;
    font-size: var(--t4);
    line-height: 1.2;
  }

  .how {
    margin-top: 3rem !important;
    color: var(--accent) !important;
  }

  .cats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    padding: 0;
    margin: 1rem 0 0;
    list-style: none;
  }

  .cats span {
    margin-left: 0.5rem;
    font-size: var(--micro);
    color: var(--dim);
  }

  /* 一年一层 */
  .layers :global(.layer) {
    position: relative;
    padding: 8vh 0 10vh;
    border-top: 1px solid color-mix(in srgb, var(--fg) 18%, transparent);
  }

  .layers :global(.year) {
    position: sticky;
    top: 4rem;
    margin: 0;
    font-size: clamp(4rem, 14vw, 11rem);
    font-weight: 400;
    font-variant-numeric: tabular-nums;
    line-height: 0.9;
    letter-spacing: -0.02em;
    color: color-mix(in srgb, var(--fg) 12%, transparent);
  }

  .layers :global(.field) {
    position: relative;
    height: calc(var(--rows) * 4.25rem + 2rem);
    padding: 0;
    margin: -4rem 14rem 0 18%;
    list-style: none;
  }

  /* 一颗星：越早的年份越小、越淡（--d 是这一层的深度） */
  .layers :global(.rec) {
    position: absolute;
    top: calc(var(--row) * 4.25rem);
    left: calc(var(--x) * (100% - 10rem));
    display: grid;
    gap: 0.1rem;
    max-width: 14rem;
    font-size: calc(var(--t1) * (1.1 - var(--d) * 0.45));
    opacity: calc(1 - var(--d) * 0.35);
  }

  .layers :global(.rec .g) {
    font-size: 0.7em;
    line-height: 1;
  }

  .layers :global(.rec.fav .g),
  .layers :global(.rec.fav a) {
    color: var(--accent);
  }

  /* 记得不准的：虚一点 */
  .layers :global(.rec.month .g) {
    filter: blur(1.2px);
  }

  .layers :global(.rec.year .g) {
    filter: blur(3px);
    transform: scaleX(3);
    transform-origin: left center;
  }

  .layers :global(.rec .when) {
    font-size: var(--micro);
    color: color-mix(in srgb, var(--fg) 55%, transparent);
  }

  .layers :global(.rec a:hover),
  .layers :global(.rec a:focus-visible) {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.25em;
  }

  /* 很久以前：一片柔和的光，宇宙最早的那种 */
  .layers :global(.long-ago) {
    min-height: 100vh;
    background: radial-gradient(70% 55% at 55% 60%, rgb(238 230 210 / 0.12), transparent 70%);
  }

  .layers :global(.long-ago .year) {
    font-size: clamp(3rem, 10vw, 8rem);
    letter-spacing: 0.3em;
    color: color-mix(in srgb, var(--fg) 20%, transparent);
  }

  /* 很久以前的不排位置：一片自然换行的字云，模糊、淡 */
  .layers :global(.long-ago .field) {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 2.25rem;
    height: auto;
    margin: 2rem 14rem 0 18%;
  }

  .layers :global(.long-ago .rec) {
    position: static;
    font-size: var(--t0);
    opacity: 0.55;
  }

  .layers :global(.long-ago .rec .when) {
    display: none;
  }

  .layers :global(.long-ago .rec .g) {
    filter: blur(2px);
  }

  /* 右边的年份索引 */
  .rail {
    position: fixed;
    top: 50%;
    right: clamp(0.75rem, 2vw, 1.5rem);
    z-index: 3;
    transform: translateY(-50%);
  }

  .rail ol {
    display: grid;
    gap: 0.3rem;
    padding: 0;
    margin: 0;
    list-style: none;
    text-align: right;
  }

  .rail :global(a) {
    font-size: var(--micro);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.15em;
    color: color-mix(in srgb, var(--fg) 50%, transparent);
  }

  .rail :global(a[aria-current]) {
    color: var(--accent);
    letter-spacing: 0.3em;
  }

  @media (max-width: 47.99rem) {
    .layers :global(.field) {
      height: auto;
      margin: 1rem 0 0;
      display: grid;
      gap: 1rem;
    }

    .layers :global(.rec) {
      position: static;
      max-width: none;
    }

    .rail {
      display: none;
    }
  }
</style>
