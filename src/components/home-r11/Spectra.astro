---
/**
 * PROTOTYPE（首页第十一轮）光谱型。main 上的记录星图（每条记录一颗星）照旧，整页按一个概念重做：哈佛光谱分类。
 * 一颗星的颜色来自它封面的主色：求出相关色温，落在 O B A F G K M 哪一型，星就画成那个温度的黑体的颜色（data.ts、spectrum.ts）。
 * 星图离中心多远是温度（热的在里，冷的在外），网格就是各型的分界圆；所有星一样大，没有谁比谁亮。
 * 星图下面是一条光谱：指着哪颗星，就是哪颗星的光谱——普朗克曲线定亮度，按它那一型刻上吸收线。没指着的时候是太阳（G2）。
 * 这一页没有另外的强调色：被指着的东西用它自己的星色。字号出自氢的巴尔末线：以 Hδ 410.2 nm 为正文，
 * Hγ 434.0、Hβ 486.1、Hα 656.3 往上，最大一级是 (Hα/Hδ)²；最小一级是 Hδ/Hβ。
 * 右边一栏：头像、一句话、光谱序列，和按光谱型分好组的全部记录。
 */
import type { HomeData } from '../../lib/home-data';
import AvatarPlaceholder from '../home/AvatarPlaceholder.astro';
import { blackbodyHex, CLASSES } from './spectrum';

interface Props {
  data: HomeData;
}
const { data } = Astro.props;
const hello = data.intro[0];
const mid = (hot: number, cool: number) => Math.sqrt(hot * cool);
const range = (hot: number, cool: number) =>
  `${cool.toLocaleString('en-US')}–${hot.toLocaleString('en-US')} K`;
---

<div class="sp" data-sp>
  <div class="chart">
    <svg class="sky" viewBox="0 0 1000 1000" data-sky role="group" aria-label="记录星图：每条记录是一颗星，颜色是它封面的色温；离中心越近越热；方向键在星之间移动"></svg>
    <div class="reading">
      <p class="read" data-read aria-live="polite"></p>
      <div class="strip">
        <canvas width="720" height="40" data-strip aria-hidden="true"></canvas>
        <div class="lines" data-lines aria-hidden="true"></div>
        <div class="nm" aria-hidden="true">
          <span style="left: 5.88%">400</span>
          <span style="left: 35.29%">500</span>
          <span style="left: 64.71%">600</span>
          <span style="left: 94.12%">700 nm</span>
        </div>
      </div>
      <div class="scope" role="group" aria-label="缩放星图">
        <button type="button" data-zoom="out" aria-label="缩小">−</button>
        <button type="button" data-zoom="in" aria-label="放大">+</button>
      </div>
    </div>
  </div>

  <aside class="side" aria-label="星表">
    <div class="head">
      <div class="avatar">
        {
          data.avatars.map((a, i) => (
            <div data-avatar-slide hidden={i > 0}>
              {a.from.record ? (
                <a href={a.from.record.href}>
                  <AvatarPlaceholder avatar={a} />
                </a>
              ) : (
                <AvatarPlaceholder avatar={a} />
              )}
            </div>
          ))
        }
        <p class="flip">
          <button type="button" data-avatar-step="1" aria-label="往回翻一个头像">‹</button>
          <button type="button" data-avatar-step="-1" aria-label="往后翻一个头像">›</button>
        </p>
      </div>
      <p class="hello voice">{hello}</p>
    </div>

    <ol class="sequence" aria-label="光谱序列，从热到冷">
      {
        CLASSES.map((c) => (
          <li style={`--c: ${blackbodyHex(mid(c.hot, c.cool))}`}>
            <span class="cls">{c.cls}</span>
          </li>
        ))
      }
    </ol>

    <div class="groups" data-groups>
      {
        CLASSES.map((c) => (
          <section data-cls={c.cls} style={`--c: ${blackbodyHex(mid(c.hot, c.cool))}`}>
            <h2>
              <span class="cls">{c.cls}</span>
              <span class="range">{range(c.hot, c.cool)}</span>
              <span class="note">{c.note}</span>
            </h2>
            <ol data-rows />
          </section>
        ))
      }
    </div>
  </aside>

  <p class="sample-note" data-sample-note hidden>示意的封面颜色</p>
  <p hidden>OBAFGKM0123456789,–Knm HαβγδDH太阳电离氦中性氢线最强钙这一型金属线氧化钛封面游戏视觉小说动画音乐年月日很久以前</p>
</div>

<style>
  .sp {
    --night: #0b0d13;
    --ink: #e6e8ee;
    --dim: color-mix(in srgb, var(--ink) 60%, var(--night));
    --faint: color-mix(in srgb, var(--ink) 34%, var(--night));
    --hair: color-mix(in srgb, var(--ink) 13%, var(--night));
    /* 字号：氢的巴尔末线 */
    --t0: 0.9375rem;
    --t-1: calc(var(--t0) * 410.2 / 486.1);
    --t1: calc(var(--t0) * 434 / 410.2);
    --t2: calc(var(--t0) * 486.1 / 410.2);
    --t3: calc(var(--t0) * 656.3 / 410.2);
    --t4: calc(var(--t0) * 656.3 * 656.3 / 168264.04);

    display: grid;
    grid-template-columns: minmax(0, 1fr) 20rem;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: start;
    color: var(--ink);
  }

  .sp::before {
    position: fixed;
    inset: 0;
    z-index: -1;
    content: '';
    background: var(--night);
  }

  /* ---------- 星图 ---------- */
  .chart {
    position: sticky;
    top: 0;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    justify-items: center;
    height: calc(100svh - 4rem);
    padding-bottom: 1rem;
  }

  .sky {
    width: auto;
    height: 100%;
    max-width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    touch-action: pan-y;
    user-select: none;
  }

  .sky :global(.ring) {
    fill: none;
    stroke: var(--hair);
    stroke-width: calc(0.8px / var(--zs, 1));
  }

  .sky :global(.ring-label) {
    font-size: calc(12px / var(--zs, 1));
    font-variant-numeric: tabular-nums;
    text-anchor: middle;
    dominant-baseline: central;
    fill: var(--faint);
  }

  .sky :global(.divider) {
    stroke: var(--hair);
    stroke-width: calc(0.8px / var(--zs, 1));
  }

  .sky :global(.rim) {
    fill: none;
    stroke: var(--faint);
    stroke-width: 1;
  }

  .sky :global(.region) {
    font-size: calc(15px / var(--zs, 1));
    letter-spacing: 0.5em;
    fill: var(--dim);
    cursor: pointer;
    outline: none;
    transition: letter-spacing 0.35s, fill 0.35s;
  }

  .sky :global(.region:hover),
  .sky :global(.region:focus-visible) {
    letter-spacing: 0.7em;
    fill: var(--ink);
  }

  .sky :global(.lines line) {
    stroke: var(--faint);
    stroke-width: calc(0.8px / var(--zs, 1));
    stroke-dasharray: 2 3;
  }

  .sky :global(.star) {
    cursor: pointer;
    outline: none;
    transition: opacity 0.25s;
  }

  .sky :global(.star .hit) {
    fill: transparent;
  }

  .sky :global(.star .glow) {
    opacity: 0.45;
  }

  .sky :global(.star .halo) {
    fill: none;
    stroke-width: calc(1px / var(--zs, 1));
    opacity: 0;
    transition: opacity 0.25s;
  }

  .sky :global(.star text) {
    display: none;
    font-size: calc(13px / var(--lod, 1));
    fill: var(--dim);
    pointer-events: none;
  }

  .sky[data-lod='1'] :global(.star text.l1),
  .sky[data-lod='2'] :global(.star text.l2),
  .sky[data-lod='4'] :global(.star text.l4) {
    display: inline;
  }

  .sky :global(.star.lit text),
  .sky :global(.star:focus-visible text) {
    fill: var(--ink);
  }

  .sky :global(.star.lit .halo),
  .sky :global(.star:focus-visible .halo) {
    opacity: 1;
  }

  .sky[data-lit] :global(.star:not(.lit)) {
    opacity: 0.45;
  }

  /* 打开时：从最热的里圈往外，一圈圈亮起来 */
  .sky[data-dark] :global(.star) {
    opacity: 0;
  }

  .sky :global(.star) {
    transition-delay: var(--at, 0s);
  }

  /* ---------- 光谱 ---------- */
  .reading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.5rem 1.5rem;
    align-items: end;
    width: min(100%, calc(100svh - 6rem));
    padding-top: 0.75rem;
  }

  .read {
    grid-column: 1 / -1;
    min-height: 1.6em;
    margin: 0;
    font-size: var(--t-1);
    color: var(--dim);
  }

  .read :global(b) {
    margin-right: 0.8em;
    font-size: var(--t1);
    font-weight: 400;
    color: var(--ink);
  }

  .read :global(.sw) {
    display: inline-block;
    width: 0.7em;
    height: 0.7em;
    margin: 0 0.35em 0 0.8em;
    vertical-align: -0.05em;
    border-radius: 50%;
  }

  .strip {
    position: relative;
    padding-bottom: 1.1rem;
  }

  .strip canvas {
    display: block;
    width: 100%;
    height: 1.75rem;
  }

  .lines {
    position: absolute;
    inset: -1rem 0 auto;
    height: 1rem;
  }

  .lines :global(span),
  .nm span {
    position: absolute;
    font-size: 0.625rem;
    font-variant-numeric: tabular-nums;
    color: var(--faint);
    transform: translateX(-50%);
    white-space: nowrap;
  }

  .nm span {
    top: calc(100% - 1rem);
  }

  .scope {
    display: flex;
    gap: 0.25rem;
    padding-bottom: 1.4rem;
  }

  .scope button {
    width: 2rem;
    height: 2rem;
    padding: 0;
    font: inherit;
    font-size: var(--t1);
    line-height: 1;
    color: var(--ink);
    cursor: pointer;
    background: none;
    border: 0;
    border-radius: 50%;
  }

  .scope button:hover,
  .scope button:focus-visible {
    outline: none;
    box-shadow: inset 0 0 0 1px currentColor;
  }

  .scope button:disabled {
    color: var(--hair);
    cursor: default;
    box-shadow: none;
  }

  /* ---------- 星表 ---------- */
  .side {
    padding: 3vh 0 12vh;
  }

  .head {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 1.25rem;
    align-items: end;
  }

  .avatar :global(.avatar) {
    width: 100%;
  }

  .flip {
    display: flex;
    justify-content: space-between;
    margin: 0.25rem 0 0;
  }

  .flip button {
    padding: 0 0.25rem;
    font: inherit;
    color: var(--dim);
    cursor: pointer;
    background: none;
    border: 0;
  }

  .flip button:disabled {
    color: var(--hair);
    cursor: default;
  }

  .hello {
    margin: 0 0 1.9rem;
    font-size: var(--t2);
    line-height: 1.3;
  }

  /* 光谱序列：七段，每段是那一型中间温度的黑体色 */
  .sequence {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    padding: 0;
    margin: 2.25rem 0 0;
    list-style: none;
  }

  .sequence li {
    display: grid;
    gap: 0.4rem;
  }

  .sequence li::before {
    height: 0.4rem;
    content: '';
    background: var(--c);
  }

  .sequence .cls {
    font-size: var(--t-1);
    text-align: center;
    color: var(--dim);
  }

  .groups section {
    margin-top: 2rem;
  }

  .groups section[data-empty] {
    display: none;
  }

  .groups h2 {
    display: grid;
    grid-template-columns: 1.75rem auto 1fr;
    gap: 0.75rem;
    align-items: baseline;
    padding-bottom: 0.5rem;
    margin: 0 0 0.4rem;
    font-size: var(--t-1);
    font-weight: 400;
    color: var(--dim);
    border-bottom: 1px solid var(--hair);
  }

  .groups h2 .cls {
    font-size: var(--t3);
    line-height: 1;
    color: var(--c);
  }

  .groups h2 .range {
    font-variant-numeric: tabular-nums;
  }

  .groups h2 .note {
    text-align: right;
    color: var(--faint);
  }

  .groups ol {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .groups :global(li) {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr) auto;
    gap: 0 0.75rem;
    align-items: baseline;
    padding: 0.28rem 0;
  }

  .groups :global(.type i) {
    font-family: 'Times New Roman', Times, serif;
    font-size: 1.1em;
  }

  .groups :global(.type) {
    font-size: var(--t-1);
    font-variant-numeric: tabular-nums;
    color: var(--faint);
  }

  .groups :global(a) {
    font-size: var(--t0);
    color: var(--ink);
    text-decoration: none;
    transition: letter-spacing 0.35s;
  }

  .groups :global(.cat) {
    font-size: var(--t-1);
    color: var(--faint);
  }

  .groups :global(li.lit a),
  .groups :global(li a:focus-visible) {
    letter-spacing: 0.06em;
    outline: none;
  }

  .groups :global(li.lit .type) {
    color: var(--star);
  }

  .sample-note {
    position: fixed;
    right: 1rem;
    bottom: 4.25rem;
    z-index: 5;
    margin: 0;
    font-size: var(--t-1);
    color: var(--dim);
  }

  @media (max-width: 51.24rem) {
    .sp {
      grid-template-columns: minmax(0, 1fr);
    }

    .chart {
      position: relative;
      height: auto;
    }

    .sky {
      width: 100%;
      height: auto;
    }

    .reading {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sky :global(.star),
    .sky :global(.region),
    .groups :global(a) {
      transition: none;
    }
  }
</style>
