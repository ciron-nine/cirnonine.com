---
/**
 * PROTOTYPE 变体 A：文字自画像（参考 Feltron 首页）。
 * 版式是「边栏 + 正文栏」两栏：边栏放头像、四个动词（类别入口）和小标签，正文栏是字。
 * 每个类别一段，整段都是作品的原名，组成这个人的材料；悬停一个动词，其余类别退后；
 * 悬停一个原名，它的译名和日期写在这一段的边栏里。手机上边栏收到每段的上方。
 * 原名统一用一种明朝体，「我的声音」用文楷，同一行里不混第三种字体。
 */
import type { HomeData, HomeRecord } from './home-data';
import AvatarPlaceholder from './AvatarPlaceholder.astro';
import RandomQuote from './RandomQuote.astro';

interface Props {
  data: HomeData;
}
const { data } = Astro.props;
const [hello, opening, closing] = data.intro;

/** 同一系列的几部挨在一起成一组，组内用斜线，组之间用间隔点；分隔符用不换行空格粘在前一个原名后面，不会出现在行首 */
function groupBySeries(records: HomeRecord[]): HomeRecord[][] {
  const groups: HomeRecord[][] = [];
  const bySeries = new Map<string, HomeRecord[]>();
  for (const record of records) {
    if (!record.series) {
      groups.push([record]);
    } else if (bySeries.has(record.series)) {
      bySeries.get(record.series)!.push(record);
    } else {
      const group = [record];
      bySeries.set(record.series, group);
      groups.push(group);
    }
  }
  return groups;
}

const gloss = (r: HomeRecord) =>
  [r.translatedTitle, r.dateLabel, r.favorite ? '心头好' : undefined].filter(Boolean).join('\n');
const CATEGORY_LABEL = Object.fromEntries(data.categories.map((c) => [c.key, c.label]));
---

<article class="portrait">
  <section class="row opening">
    <div class="margin" data-avatar-history>
      {
        data.avatars.map((avatar) => (
          <div class="slide" data-avatar-slide>
            {avatar.from.record ? (
              <a href={avatar.from.record.href}>
                <AvatarPlaceholder avatar={avatar} class="face" />
              </a>
            ) : (
              <AvatarPlaceholder avatar={avatar} class="face" />
            )}
          </div>
        ))
      }
      <p class="avatar-steps">
        <button type="button" data-avatar-step="1" aria-label="往回翻一个头像">‹</button>
        <button type="button" data-avatar-step="-1" aria-label="往后翻一个头像">›</button>
      </p>
    </div>
    <div class="text">
      <p class="hello voice">{hello}</p>
      {opening && <p class="prose voice">{opening}</p>}
    </div>
  </section>

  <div class="stanzas">
    {
      data.categories.map((category) => (
        <section class="row stanza" aria-label={category.label}>
          <div class="margin">
            <a class="door" href={category.href}>
              <span class="verb voice">{category.verb}</span>
              <span class="count">{category.records.length}</span>
            </a>
            <p class="gloss voice" data-gloss aria-hidden="true" />
          </div>
          <p class="text titles">
            {groupBySeries(category.records).map((group, gi) => (
              <>
                {gi > 0 && (
                  <span class="sep" aria-hidden="true">
                    {'\u00a0· '}
                  </span>
                )}
                <span class="group">
                  {group.map((record, ri) => (
                    <>
                      {ri > 0 && (
                        <span class="slash" aria-hidden="true">
                          {'\u00a0／ '}
                        </span>
                      )}
                      <a
                        class:list={['work', { favorite: record.favorite, short: Array.from(record.originalTitle).length <= 10 }]}
                        href={record.href}
                        lang={record.lang}
                        data-gloss-text={gloss(record)}
                      >
                        {record.originalTitle}
                      </a>
                    </>
                  ))}
                </span>
              </>
            ))}
          </p>
        </section>
      ))
    }
  </div>

  {
    closing && (
      <section class="row">
        <div class="margin" />
        <p class="text prose voice">{closing}</p>
      </section>
    )
  }

  <section class="row aside" aria-label="随机一句语录">
    <p class="margin label voice">随手一句</p>
    <div class="text">
      <RandomQuote quotes={data.quotes} />
    </div>
  </section>

  <section class="row aside" aria-label="最近完成">
    <p class="margin label voice">最近</p>
    <ol class="text recent">
      {
        data.recent.map((record) => (
          <li>
            <a class="work" href={record.href} lang={record.lang}>
              {record.originalTitle}
            </a>
            <span class="meta voice">
              {CATEGORY_LABEL[record.category]} ·{' '}
              {record.datetime ? <time datetime={record.datetime}>{record.dateLabel}</time> : record.dateLabel}
            </span>
          </li>
        ))
      }
    </ol>
  </section>
</article>

<script>
  /** 悬停或聚焦一个原名时，把译名和日期写进这一段的边栏；离开这一段就清掉 */
  document.addEventListener('astro:page-load', () => {
    for (const stanza of document.querySelectorAll<HTMLElement>('.portrait .stanza')) {
      const gloss = stanza.querySelector<HTMLElement>('[data-gloss]');
      if (!gloss) continue;
      const show = (event: Event) => {
        const work = (event.target as Element).closest<HTMLElement>('[data-gloss-text]');
        if (work) gloss.textContent = work.dataset.glossText ?? '';
      };
      stanza.addEventListener('pointerover', show);
      stanza.addEventListener('focusin', show);
      stanza.addEventListener('pointerleave', () => (gloss.textContent = ''));
      stanza.addEventListener('focusout', () => (gloss.textContent = ''));
    }
  });
</script>

<style>
  .portrait {
    --a-title: 'Shippori Mincho', 'Songti SC', 'Noto Serif CJK SC', serif;
    --a-rule: color-mix(in srgb, var(--shell-fg) 18%, transparent);

    max-width: 64rem;
    margin: 0 auto;
    padding: clamp(1.5rem, 6vw, 5rem) 0 3rem;
  }

  .voice {
    font-family: var(--proto-voice);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  /* 两栏：窄边栏 + 正文栏，所有段落都对齐在同一条正文左边线上 */
  .row {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 46rem);
    column-gap: clamp(1.5rem, 4vw, 3.5rem);
  }

  .margin {
    min-width: 0;
  }

  .text {
    min-width: 0;
    margin: 0;
  }

  /* 开头：头像在边栏，正文栏是「我是 cirnonine。」和一段话 */
  .opening {
    align-items: start;
    margin-bottom: clamp(3rem, 8vw, 5.5rem);
  }

  .slide[hidden] {
    display: none;
  }

  .slide a {
    display: block;
  }

  .slide :global(.face) {
    display: grid;
    width: 4.5rem;
  }

  .avatar-steps {
    display: flex;
    gap: 0.25rem;
    margin: 0.35rem 0 0;
  }

  .avatar-steps button {
    padding: 0 0.35rem;
    font: inherit;
    font-size: 1rem;
    line-height: 1;
    color: var(--shell-muted);
    cursor: pointer;
    background: none;
    border: 0;
  }

  .avatar-steps button:disabled {
    cursor: default;
    opacity: 0.25;
  }

  .hello {
    margin: 0 0 1.25rem;
    font-size: clamp(2rem, 1.2rem + 3.2vw, 3.75rem);
    line-height: 1.15;
  }

  .prose {
    max-width: 30em;
    margin: 0;
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem);
    line-height: 1.9;
    text-wrap: pretty;
  }

  /* 四段材料：边栏是动词（入口）和件数，正文栏是一整段原名 */
  .stanza {
    padding: 1.5rem 0 1.75rem;
    border-top: 1px solid var(--a-rule);
    transition: opacity 0.25s;
  }

  .stanza:last-child {
    border-bottom: 1px solid var(--a-rule);
  }

  .stanzas:has(.door:hover, .door:focus-visible) .stanza:not(:has(.door:hover, .door:focus-visible)) {
    opacity: 0.2;
  }

  .door {
    display: inline-flex;
    gap: 0.4rem;
    align-items: baseline;
  }

  .verb {
    font-size: 1.25rem;
    border-bottom: 2px solid currentColor;
  }

  .count {
    font-family: var(--proto-mono);
    font-size: 0.75rem;
    color: var(--shell-muted);
    font-variant-numeric: tabular-nums;
  }

  .door:hover .verb,
  .door:focus-visible .verb {
    color: var(--shell-bg);
    background: var(--shell-fg);
  }

  .door:focus-visible {
    outline: none;
  }

  /* 悬停一个原名时出现在边栏里的译名和日期 */
  .gloss {
    min-height: 3em;
    margin: 0.75rem 0 0;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--shell-muted);
    white-space: pre-line;
  }

  .titles {
    font-family: var(--a-title);
    font-size: clamp(1.1875rem, 0.95rem + 1.1vw, 1.75rem);
    line-height: 1.75;
    text-wrap: pretty;
    line-break: strict;
  }

  .work {
    transition: opacity 0.2s;
  }

  .work:lang(ja) {
    word-break: auto-phrase;
  }

  /* 短的原名不拆开换行 */
  .short {
    white-space: nowrap;
  }

  .work:hover,
  .work:focus-visible {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .favorite::after {
    margin-left: 0.1em;
    font-size: 0.55em;
    vertical-align: super;
    content: '＊';
  }

  .sep,
  .slash {
    color: var(--shell-muted);
  }

  .slash {
    font-size: 0.7em;
  }

  /* 结尾那段话、随手一句、最近：仍然对齐在正文栏 */
  .row:not(.stanza, .opening) {
    padding-top: clamp(2.5rem, 6vw, 4rem);
  }

  .label {
    margin: 0;
    padding-top: 0.2rem;
    font-size: 0.875rem;
    color: var(--shell-muted);
  }

  .recent {
    display: grid;
    gap: 0.6rem;
    padding: 0;
    list-style: none;
  }

  .recent li {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1rem;
    align-items: baseline;
  }

  .recent .work {
    font-family: var(--a-title);
    font-size: 1.25rem;
  }

  .meta {
    font-size: 0.8125rem;
    color: var(--shell-muted);
  }

  /* 手机：边栏收到每一段的上方，变成一行小标题 */
  @media (max-width: 40rem) {
    .row {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0.75rem;
    }

    .opening .margin {
      display: flex;
      gap: 0.5rem;
      align-items: end;
    }

    .slide :global(.face) {
      width: 3.5rem;
    }

    .avatar-steps {
      margin: 0;
    }

    .stanza {
      padding: 1.25rem 0 1.5rem;
    }

    .gloss {
      display: none;
    }

    .recent .meta {
      flex-basis: 100%;
    }

    .label:empty,
    .margin:empty {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stanza,
    .work {
      transition: none;
    }
  }
</style>
