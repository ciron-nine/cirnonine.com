---
/**
 * PROTOTYPE 变体 D：专辑内页（CD 歌词本）。
 * 首页是一本方形小册子，一页一块方形，桌面上两页一摊（中间有折缝），手机上一页一页往下翻。
 * 第一摊：封面（头像，可以翻到旧版封面）｜ 收录曲目（四个类别和它们的原名）
 * 第二摊：内页文字（自我介绍）｜ 摘录（随机语录）
 * 第三摊：最近完成（最近 5 条）｜ 版权页（字体、说明）
 */
import type { HomeData } from './home-data';
import AvatarPlaceholder from './AvatarPlaceholder.astro';
import RandomQuote from './RandomQuote.astro';

interface Props {
  data: HomeData;
}
const { data } = Astro.props;
const [hello, ...notes] = data.intro;
const catalog = `CN-${String(data.total).padStart(3, '0')}`;
const CATEGORY_LABEL = Object.fromEntries(data.categories.map((c) => [c.key, c.label]));
---

<article class="booklet">
  <div class="spread">
    <section class="page cover" aria-label="封面" data-avatar-history>
      {
        data.avatars.map((avatar, i) => (
          <figure class="slide" data-avatar-slide>
            <AvatarPlaceholder avatar={avatar} class="face" />
            <figcaption>
              <span>{i === 0 ? '现行封面' : `第 ${data.avatars.length - i} 版`}</span>
              <span>
                {avatar.name}／
                {avatar.from.record ? (
                  <a href={avatar.from.record.href}>{avatar.from.title}</a>
                ) : (
                  avatar.from.title
                )}
              </span>
            </figcaption>
          </figure>
        ))
      }
      <p class="cover-mark">cirnonine</p>
      <p class="cover-catalog">{catalog}</p>
      <p class="cover-steps">
        <button type="button" data-avatar-step="1" aria-label="翻到更早的封面（头像）">← 旧版</button>
        <span data-avatar-position></span>
        <button type="button" data-avatar-step="-1" aria-label="翻到更近的封面（头像）">新版 →</button>
      </p>
    </section>

    <section class="page tracklist" aria-label="收录">
      <h2 class="label">收录</h2>
      <ol>
        {
          data.categories.map((category, i) => (
            <li>
              <a class="track" href={category.href}>
                <span class="no">{String(i + 1).padStart(2, '0')}</span>
                <span class="name">{category.label}</span>
                <span class="leader" aria-hidden="true" />
                <span class="len">{category.records.length}</span>
              </a>
              <p class="titles">
                {category.records.map((r, ri) => (
                  <>
                    {ri > 0 && ' / '}
                    <a href={r.href} lang={r.lang}>
                      {r.originalTitle}
                    </a>
                  </>
                ))}
              </p>
            </li>
          ))
        }
      </ol>
    </section>
  </div>

  <div class="spread">
    <section class="page notes" aria-label="内页文字">
      <h2 class="label">写在里面</h2>
      <div class="notes-body voice">
        <p class="hello">{hello}</p>
        {notes.map((p) => <p>{p}</p>)}
      </div>
      <p class="sign voice">— c9</p>
    </section>

    <section class="page lyric" aria-label="摘录">
      <h2 class="label">摘录</h2>
      <div class="lyric-body">
        <RandomQuote quotes={data.quotes} />
      </div>
    </section>
  </div>

  <div class="spread">
    <section class="page credits" aria-label="最近完成">
      <h2 class="label">最近完成</h2>
      <dl>
        {
          data.recent.map((record) => (
            <div class="credit">
              <dt>
                <a href={record.href} lang={record.lang}>
                  {record.originalTitle}
                </a>
              </dt>
              <dd>
                <span class="leader" aria-hidden="true" />
                {CATEGORY_LABEL[record.category]} ·{' '}
                {record.datetime ? <time datetime={record.datetime}>{record.dateLabel}</time> : record.dateLabel}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="page colophon" aria-label="版权页">
      <h2 class="label">版权页</h2>
      <dl class="colophon-list">
        <dt>编号</dt>
        <dd>{catalog}（记录总数）</dd>
        <dt>正文 / 我的声音</dt>
        <dd>霞鹜文楷</dd>
        <dt>原名</dt>
        <dd>Shippori Mincho · Instrument Serif</dd>
        <dt>编号与日期</dt>
        <dd>IBM Plex Mono</dd>
        <dt>说明</dt>
        <dd class="voice">头像、文字、语录都是占位。</dd>
      </dl>
      <p class="barcode" aria-hidden="true" title="一根线是一条记录">
        {data.categories.map((c) => (
          <span class="bars">
            {c.records.map((r) => (
              <span class:list={{ fav: r.favorite }} />
            ))}
          </span>
        ))}
      </p>
    </section>
  </div>
</article>

<style>
  .booklet {
    --paper: light-dark(#efede6, #1c1c1a);
    --ink: light-dark(#141414, #ecebe6);
    --faint: light-dark(#77756e, #8f8d86);
    --rule: light-dark(rgb(0 0 0 / 0.55), rgb(255 255 255 / 0.4));

    display: grid;
    gap: clamp(2rem, 6vw, 4rem);
    max-width: 66rem;
    margin: 0 auto;
    padding: clamp(1rem, 4vw, 3rem) 0 2rem;
  }

  .voice {
    font-family: var(--proto-voice);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:hover,
  a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* 两页一摊，中间一道折缝的阴影 */
  .spread {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    color: var(--ink);
    background: var(--paper);
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.15),
      0 12px 32px -12px rgb(0 0 0 / 0.35);
  }

  .spread::after {
    position: absolute;
    inset: 0 auto 0 50%;
    width: 3rem;
    pointer-events: none;
    content: '';
    background: linear-gradient(to right, rgb(0 0 0 / 0.12), transparent 30%, transparent 70%, rgb(0 0 0 / 0.06));
    transform: translateX(-50%);
  }

  .page {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    aspect-ratio: 1;
    padding: clamp(1.25rem, 3.5vw, 2.5rem);
    overflow-wrap: anywhere;
  }

  .label {
    margin: 0 0 1.5rem;
    font-family: var(--proto-mono);
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.25em;
    color: var(--faint);
  }

  /* 封面：头像占满整页，四角是站名、编号和翻页 */
  .cover {
    /* 桌面上和对页一样高 */
    aspect-ratio: auto;
    padding: 0;
    overflow: hidden;
    color: #f4f3ee;
    background: #222;
  }

  .cover .slide {
    position: absolute;
    inset: 0;
    margin: 0;
  }

  .cover .slide[hidden] {
    display: none;
  }

  .cover :global(.face) {
    width: 100%;
    height: 100%;
    filter: contrast(1.2) grayscale(1);
  }

  .cover figcaption {
    position: absolute;
    bottom: 3.25rem;
    left: clamp(1rem, 3vw, 1.75rem);
    display: grid;
    font-family: var(--proto-voice);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .cover figcaption span:first-child {
    font-family: var(--proto-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.15em;
    opacity: 0.7;
  }

  .cover-mark,
  .cover-catalog {
    position: absolute;
    top: clamp(1rem, 3vw, 1.75rem);
    margin: 0;
    font-family: var(--proto-mono);
    font-size: 0.75rem;
    letter-spacing: 0.3em;
  }

  .cover-mark {
    left: clamp(1rem, 3vw, 1.75rem);
  }

  .cover-catalog {
    right: clamp(1rem, 3vw, 1.75rem);
  }

  .cover-steps {
    position: absolute;
    right: clamp(1rem, 3vw, 1.75rem);
    bottom: clamp(0.75rem, 2vw, 1.25rem);
    left: clamp(1rem, 3vw, 1.75rem);
    display: flex;
    gap: 0.5rem;
    align-items: center;
    justify-content: space-between;
    margin: 0;
    font-family: var(--proto-mono);
    font-size: 0.6875rem;
  }

  .cover-steps button {
    padding: 0.35rem 0.6rem;
    font: inherit;
    color: inherit;
    cursor: pointer;
    background: rgb(0 0 0 / 0.35);
    border: 1px solid rgb(255 255 255 / 0.6);
  }

  .cover-steps button:disabled {
    cursor: default;
    opacity: 0.3;
  }

  /* 收录：编号、类别名、点线、件数；下面是这一轨里的所有原名 */
  .tracklist ol {
    display: grid;
    gap: 1.25rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .track {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    font-size: clamp(1.125rem, 0.9rem + 1vw, 1.5rem);
  }

  .no,
  .len {
    font-family: var(--proto-mono);
    font-size: 0.6em;
    font-variant-numeric: tabular-nums;
  }

  .name {
    font-family: var(--proto-voice);
  }

  .leader {
    flex: 1;
    min-width: 1rem;
    border-bottom: 1px dotted var(--rule);
    transform: translateY(-0.3em);
  }

  .titles {
    margin: 0.35rem 0 0 calc(0.6em + 0.75rem + 1ch);
    font-family: var(--proto-title);
    font-size: 0.6875rem;
    line-height: 1.6;
    color: var(--faint);
  }

  .titles [lang='ja'] {
    font-family: var(--proto-title-ja);
  }

  /* 内页文字：小字、两栏，最后署名 */
  .notes-body {
    flex: 1;
    font-size: 0.9375rem;
    line-height: 1.9;
    columns: 2 12rem;
    column-gap: 1.75rem;
  }

  .notes-body p {
    margin: 0 0 0.9em;
  }

  .hello {
    font-size: 1.5rem;
    line-height: 1.3;
    column-span: all;
  }

  .sign {
    margin: 1rem 0 0;
    text-align: right;
  }

  /* 摘录：语录居中放在整页里，周围留大片空白 */
  .lyric-body {
    display: grid;
    flex: 1;
    place-items: center;
  }

  .lyric-body :global([data-random-item]) {
    width: 100%;
  }

  .lyric-body :global(figure) {
    margin-inline: auto;
  }

  /* 最近完成：像内页最后的录音信息 */
  .credits dl {
    display: grid;
    gap: 0.9rem;
    margin: 0;
  }

  .credit {
    display: grid;
    gap: 0.15rem;
  }

  .credit dt {
    font-family: var(--proto-title);
    font-size: 1.125rem;
    line-height: 1.3;
  }

  .credit dt :global([lang='ja']) {
    font-family: var(--proto-title-ja);
  }

  .credit dd {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
    margin: 0;
    font-family: var(--proto-voice);
    font-size: 0.8125rem;
    color: var(--faint);
  }

  /* 版权页 */
  .colophon-list {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.4rem 1rem;
    margin: 0;
    font-size: 0.75rem;
    line-height: 1.6;
  }

  .colophon-list dt {
    font-family: var(--proto-mono);
    color: var(--faint);
  }

  .colophon-list dd {
    margin: 0;
  }

  /* 四个类别的件数画成一排粗细不一的竖条 */
  /* 条码：一条记录一根竖线，心头好粗一点，类别之间空一格 */
  .barcode {
    display: flex;
    gap: 6px;
    height: 3rem;
    margin: auto 0 0;
  }

  .bars {
    display: flex;
    gap: 2px;
  }

  .bars span {
    width: 1px;
    background: var(--ink);
  }

  .bars .fav {
    width: 3px;
  }

  @media (max-width: 40rem) {
    .spread {
      grid-template-columns: 1fr;
    }

    /* 手机上一页一页往下翻，折缝换成页与页之间的一道横线 */
    .spread::after {
      display: none;
    }

    .page + .page {
      border-top: 1px dashed var(--rule);
    }

    .cover {
      aspect-ratio: 1;
    }

    .page:not(.cover) {
      aspect-ratio: auto;
    }

    .lyric {
      min-height: 50svh;
    }

    .notes-body {
      columns: 1;
    }
  }
</style>
