---
/**
 * PROTOTYPE（首页第十轮）视星等。main 上的记录星图（每条记录一颗星）照旧，整页换成一个概念：星等。
 * 星等是喜帕恰斯的六等、普森的 2.512，量的是从这里看过去多亮（见 data.ts）。这一页所有的「数」都从它来：
 * - 一个比：10^0.1 ≈ 1.259，就是 2.512 的四次方根（四分之一个星等）
 *   字号一级大 1.259 倍，从正文到最大的字正好差一个星等；星的半径暗一等小 1.259 倍
 * - 灰：亮度按星等算出来——暗半等 63%、暗一等 40%、暗两等 16%，没有随手写的灰
 * - 缩放就是换口径：极限星等 = 6 + 5·log10(放大倍数)，放大一倍多看见暗 1.5 等的星；读数就写在缩放按钮旁边
 * - 名字只标看得见的星；打开时星按星等出来，像天黑下来，先看见一等星
 * 只有一种颜色：纸、墨，和一个朱色，朱色只标「正指着的那一颗」。没有卡片、阴影、背景星和流星：图上每一个点都是一条记录。
 * 右边一栏是星表：头像、一句话、星等的图例、按亮度排的全部记录（拜耳命名：天区里最亮的叫 α）。
 */
import type { HomeData } from '../../lib/home-data';
import AvatarPlaceholder from '../home/AvatarPlaceholder.astro';

interface Props {
  data: HomeData;
}
const { data } = Astro.props;
const hello = data.intro[0];
const KEY: [number, string][] = [
  [1, '心头好'],
  [2, '写过长评'],
  [3, '写过短评'],
  [4, '记得哪一天、哪个月'],
  [4.6, '只记得哪一年'],
  [6, '很久以前'],
];
const r = (m: number) => 7 * Math.pow(10, -0.1 * (m - 1));
---

<div class="atlas" data-atlas>
  <div class="chart">
    <svg class="sky" viewBox="0 0 1000 1000" data-sky role="group" aria-label="记录星图：每条记录是一颗星，越亮的星，我在它身上留下的越多；方向键从亮到暗在星之间移动"></svg>
    <div class="bar">
      <p class="read" data-read aria-live="polite"></p>
      <div class="scope" role="group" aria-label="缩放星图">
        <button type="button" data-zoom="out" aria-label="缩小">−</button>
        <p class="lm"><span>极限星等</span> <output data-lm>6.0</output></p>
        <button type="button" data-zoom="in" aria-label="放大">+</button>
      </div>
    </div>
  </div>

  <aside class="table" aria-label="星表">
    <div class="head">
      <div class="avatar" data-avatars>
        {
          data.avatars.map((a, i) => (
            <div data-avatar-slide hidden={i > 0}>
              {a.from.record ? (
                <a href={a.from.record.href}>
                  <AvatarPlaceholder avatar={a} />
                </a>
              ) : (
                <AvatarPlaceholder avatar={a} />
              )}
            </div>
          ))
        }
        <p class="flip">
          <button type="button" data-avatar-step="1" aria-label="往回翻一个头像">‹</button>
          <button type="button" data-avatar-step="-1" aria-label="往后翻一个头像">›</button>
        </p>
      </div>
      <p class="hello voice">{hello}</p>
    </div>

    <ul class="key" aria-label="星等">
      {
        KEY.map(([m, label]) => (
          <li>
            <svg viewBox="-8 -8 16 16" aria-hidden="true">
              <circle r={r(m)} />
            </svg>
            <span class="m">{m === 4.6 ? '4.5' : m}</span>
            <span>{label}</span>
          </li>
        ))
      }
    </ul>

    <ol class="list" data-list></ol>
  </aside>

  <p class="sample-note" data-sample-note hidden>示意日期和评论</p>
  <p hidden>αβγδεζηθικλμνξοπρστυφχψω0123456789.h−+极限星等游戏视觉小说动画音乐年月日很久以前心头好</p>
</div>

<style>
  .atlas {
    /* 三色 */
    --paper: #eef0f3;
    --ink: #0e1424;
    --zhu: #c4313b;
    /* 灰按星等算：暗半等、一等、两等 */
    --dim: color-mix(in srgb, var(--ink) 63.1%, var(--paper));
    --faint: color-mix(in srgb, var(--ink) 39.8%, var(--paper));
    --hair: color-mix(in srgb, var(--ink) 15.8%, var(--paper));
    /* 字号：一级 10^0.1，四级正好一个星等 */
    --q: 1.2589;
    --t-1: calc(var(--t0) / var(--q));
    --t0: 0.9375rem;
    --t1: calc(var(--t0) * var(--q));
    --t2: calc(var(--t1) * var(--q));
    --t3: calc(var(--t2) * var(--q));
    --t4: calc(var(--t3) * var(--q));

    display: grid;
    grid-template-columns: minmax(0, 1fr) 21rem;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: start;
    color: var(--ink);
  }

  .atlas::before {
    position: fixed;
    inset: 0;
    z-index: -1;
    content: '';
    background: var(--paper);
  }

  /* ---------- 星图 ---------- */
  .chart {
    position: sticky;
    top: 0;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    justify-items: center;
    height: calc(100svh - 4rem);
    padding-bottom: 1.25rem;
  }

  .sky {
    width: auto;
    height: 100%;
    max-width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    touch-action: pan-y;
    user-select: none;
  }

  .sky :global(.grid) {
    fill: none;
    stroke: var(--hair);
    stroke-width: calc(0.8px / var(--zs, 1));
  }

  .sky :global(.bounds) {
    fill: none;
    stroke: var(--faint);
    stroke-width: calc(0.8px / var(--zs, 1));
    stroke-dasharray: 5 4;
  }

  .sky :global(.rim) {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.2;
  }

  .sky :global(.hours) {
    font-size: calc(11px / var(--zs, 1));
    font-variant-numeric: tabular-nums;
    fill: var(--dim);
  }

  .sky :global(.region) {
    font-size: calc(19px / var(--zs, 1));
    letter-spacing: 0.6em;
    fill: var(--faint);
    cursor: pointer;
    outline: none;
    transition: letter-spacing 0.35s, fill 0.35s;
  }

  .sky :global(.region:hover),
  .sky :global(.region:focus-visible) {
    letter-spacing: 0.8em;
    fill: var(--ink);
  }

  .sky :global(.lines line) {
    stroke: var(--faint);
    stroke-width: calc(0.9px / var(--zs, 1));
  }

  .sky :global(.lines line.lit) {
    stroke: var(--zhu);
  }

  /* 星：墨点，外面一圈纸色，线从星旁边断开（星图的老规矩） */
  .sky :global(.star) {
    cursor: pointer;
    outline: none;
  }

  .sky :global(.star .hit) {
    fill: transparent;
  }

  .sky :global(.star .dot) {
    fill: var(--ink);
    stroke: var(--paper);
    stroke-width: calc(1.6px / var(--zs, 1));
    transition: fill 0.2s, opacity 0.3s;
  }

  .sky :global(.star.below .dot) {
    opacity: 0.4;
  }

  .sky :global(.star text) {
    display: none;
    font-size: calc(13px / var(--lod, 1));
    fill: var(--ink);
    pointer-events: none;
  }

  .sky[data-lod='1'] :global(.star text.l1),
  .sky[data-lod='2'] :global(.star text.l2),
  .sky[data-lod='4'] :global(.star text.l4) {
    display: inline;
  }

  .sky :global(.star.dimmer text) {
    fill: var(--dim);
  }

  .sky :global(.star:hover .dot),
  .sky :global(.star:focus-visible .dot),
  .sky :global(.star.lit .dot) {
    fill: var(--zhu);
    opacity: 1;
  }

  .sky :global(.star:hover text),
  .sky :global(.star:focus-visible text),
  .sky :global(.star.lit text) {
    fill: var(--zhu);
  }

  /* 打开时：天黑下来，星按星等一颗颗出来 */
  .sky[data-dusk] :global(.star),
  .sky[data-dusk] :global(.lines line) {
    opacity: 0;
  }

  .sky :global(.star),
  .sky :global(.lines line) {
    transition: opacity 0.9s ease-out;
    transition-delay: var(--at, 0s);
  }

  .bar {
    display: flex;
    gap: 2rem;
    justify-content: space-between;
    align-items: baseline;
    width: min(100%, calc(100svh - 7rem));
    padding-top: 0.75rem;
    border-top: 1px solid var(--hair);
  }

  .read {
    min-height: 1.5em;
    margin: 0;
    font-size: var(--t-1);
    color: var(--dim);
  }

  .read :global(b) {
    margin-right: 0.75em;
    font-size: var(--t0);
    font-weight: 400;
    color: var(--ink);
  }

  .scope {
    display: flex;
    gap: 0.25rem;
    align-items: center;
    flex: none;
  }

  .scope button {
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    font: inherit;
    font-size: var(--t1);
    line-height: 1;
    color: var(--ink);
    cursor: pointer;
    background: none;
    border: 0;
    border-radius: 50%;
  }

  .scope button:hover,
  .scope button:focus-visible {
    outline: none;
    box-shadow: inset 0 0 0 1px currentColor;
  }

  .scope button:disabled {
    color: var(--hair);
    cursor: default;
    box-shadow: none;
  }

  .lm {
    margin: 0 0.25rem;
    font-size: var(--t-1);
    letter-spacing: 0.2em;
    color: var(--dim);
  }

  .lm output {
    font-size: var(--t0);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.05em;
    color: var(--ink);
  }

  /* ---------- 星表 ---------- */
  .table {
    padding: 3vh 0 12vh;
  }

  .head {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 1.25rem;
    align-items: end;
  }

  .avatar {
    position: relative;
  }

  .avatar :global(.avatar) {
    width: 100%;
  }

  .flip {
    display: flex;
    justify-content: space-between;
    margin: 0.25rem 0 0;
  }

  .flip button {
    padding: 0 0.25rem;
    font: inherit;
    color: var(--dim);
    cursor: pointer;
    background: none;
    border: 0;
  }

  .flip button:disabled {
    color: var(--hair);
    cursor: default;
  }

  .hello {
    margin: 0 0 1.9rem;
    font-size: var(--t2);
    line-height: 1.3;
  }

  .key {
    display: grid;
    gap: 0.15rem;
    padding: 1.25rem 0;
    margin: 2rem 0 0;
    list-style: none;
    font-size: var(--t-1);
    color: var(--dim);
    border-top: 1px solid var(--hair);
    border-bottom: 1px solid var(--hair);
  }

  .key li {
    display: grid;
    grid-template-columns: 1.25rem 2rem 1fr;
    align-items: center;
  }

  .key svg {
    width: 1rem;
    height: 1rem;
  }

  .key circle {
    fill: var(--ink);
  }

  .key .m {
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }

  .list {
    padding: 0;
    margin: 1.5rem 0 0;
    list-style: none;
    counter-reset: none;
  }

  .list :global(li) {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr) auto;
    gap: 0 0.5rem;
    align-items: baseline;
    padding: 0.3rem 0;
  }

  .list :global(.bayer) {
    font-size: var(--t0);
    font-style: italic;
    color: var(--dim);
  }

  .list :global(a) {
    font-size: var(--t0);
    color: var(--ink);
    text-decoration: none;
    transition: letter-spacing 0.35s;
  }

  .list :global(.cat) {
    grid-column: 2;
    font-size: var(--t-1);
    color: var(--faint);
  }

  .list :global(.mag) {
    grid-row: 1;
    grid-column: 3;
    font-size: var(--t-1);
    font-variant-numeric: tabular-nums;
    color: var(--dim);
  }

  /* 整等之间一道发丝线：一等星、二等星……分开 */
  .list :global(li.first) {
    margin-top: 0.6rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--hair);
  }

  .list :global(li.lit a),
  .list :global(li:hover a) {
    letter-spacing: 0.06em;
  }

  .list :global(li.lit .bayer),
  .list :global(li.lit .mag) {
    color: var(--zhu);
  }

  .sample-note {
    position: fixed;
    right: 1rem;
    bottom: 4.25rem;
    z-index: 5;
    margin: 0;
    font-size: var(--t-1);
    color: var(--zhu);
  }

  @media (max-width: 51.24rem) {
    .atlas {
      grid-template-columns: minmax(0, 1fr);
    }

    .chart {
      position: relative;
      height: auto;
    }

    .sky {
      width: 100%;
      height: auto;
    }

    .bar {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sky :global(.star),
    .sky :global(.lines line),
    .sky :global(.region),
    .list :global(a) {
      transition: none;
    }
  }
</style>
