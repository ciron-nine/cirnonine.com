---
import Shell from '../components/shell/Shell.astro';
import CosmosBackdrop from '../components/home-hero-prototype/CosmosBackdrop.astro';
import Booklet from '../components/home-hero-prototype/Booklet.astro';
import { loadHomeData } from '../components/home-hero-prototype/home-data';

const data = await loadHomeData();
---

<!--
  PROTOTYPE（第四轮，#19）：星空下的一本专辑小册子。往下滚就是翻书，镜头跟着翻页从星空飞到行星、再到星系。
  小册子在 home-hero-prototype/Booklet.astro，背景在 gl-cosmos.ts。正式首页按选定方案在 #19 里重写。
-->
<Shell title="cirnonine">
  <CosmosBackdrop data={data} />
  <main id="main">
    <h1 class="visually-hidden">cirnonine</h1>
    <Booklet data={data} />
  </main>
</Shell>

<style is:global>
  /* 首页固定是夜里：外壳的颜色都取深色那一套（只在首页，换页时这段样式跟着换掉） */
  :root {
    color-scheme: dark;
  }
</style>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
