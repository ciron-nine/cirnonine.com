---
import Shell from '../components/shell/Shell.astro';
import HomeBackdrop from '../components/home-hero-prototype/HomeBackdrop.astro';
import BookletStub from '../components/home-hero-prototype/BookletStub.astro';
import PrototypeSwitcher from '../components/prototype/PrototypeSwitcher.astro';
---

<!-- 占位首页：正式首页是 #19（D 专辑内页）。PROTOTYPE：全屏背景的三个数学变体，?variant=A / B / C -->
<Shell title="cirnonine">
  <HomeBackdrop />
  <main id="main">
    <h1 class="visually-hidden">cirnonine</h1>
    <BookletStub />
  </main>
  {import.meta.env.DEV && <PrototypeSwitcher />}
</Shell>

<script>
  import { showCurrentVariant } from '../components/prototype/variants';

  document.addEventListener('astro:page-load', () => {
    if (document.querySelector('[data-prototype-variants]')) showCurrentVariant();
  });
</script>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
