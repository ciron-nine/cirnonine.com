---
/**
 * PROTOTYPE（首页第十三轮）：夜航海图——每条记录是一盏灯，按自己的灯质闪。
 * A 夜航海图；「现行」是 main 上现在的首页，放在一起对比。
 * ?variant=A|0 切换，开发环境底部有切换条；?sample=1 用示意的封面颜色。
 */
import PrototypeSwitcher from '../components/prototype/PrototypeSwitcher.astro';
import RecordsIsland from '../components/home-r13/RecordsIsland.astro';
import Nautical from '../components/home-r13/Nautical.astro';
import Shell from '../components/shell/Shell.astro';
import StarChart from '../components/home/StarChart.astro';
import StarTable from '../components/home/StarTable.astro';
import { loadHomeData } from '../lib/home-data';
import { starChart } from '../lib/star-chart';

const data = await loadHomeData();
const chart = starChart(data);
---

<Shell title="cirnonine">
  <main id="main" data-prototype-variants>
    <h1 class="visually-hidden">cirnonine</h1>
    <RecordsIsland data={data} />
    <div data-variant="A" data-variant-name="夜航海图">
      <Nautical data={data} />
    </div>
    <div data-variant="0" data-variant-name="现行（main 上的首页）" hidden>
      <div class="home" data-home>
        <div class="chart">
          <StarChart chart={chart} />
        </div>
        <StarTable data={data} regions={chart.regions} />
      </div>
    </div>
  </main>
  {import.meta.env.DEV && <PrototypeSwitcher />}
</Shell>

<script>
  import '../components/home/home';
  import '../components/home-r13/r13';
</script>

<style is:global>
  [data-prototype-variants] > [hidden] {
    display: none !important;
  }
</style>

<style is:global>
  /* 首页是一张白纸：外壳的颜色取浅色那一套（只在首页，换页时这段样式跟着换掉） */
  :root {
    color-scheme: light;
  }

  /* PROTOTYPE：夜航海图是暗的，外壳跟着用深色那一套 */
  :root:has([data-variant='A']:not([hidden])) {
    color-scheme: dark;
  }
</style>

<style>
  .home {
    --paper: #f3f5f8;
    --ink: #0f1420;
    --faint: #5d6678;
    --grid: #2f64b0;
    --red: #c8323e;

    display: grid;
    grid-template-columns: minmax(0, 1fr) 22rem;
    gap: 2rem;
    align-items: start;
    min-height: calc(100svh - 4rem);
    color: var(--ink);
  }

  /* 白纸铺满整个视口，盖住外壳原来的底色 */
  .home::before {
    position: fixed;
    inset: 0;
    z-index: -1;
    content: '';
    background: var(--paper);
  }

  .chart {
    position: sticky;
    top: 0;
    display: grid;
    place-items: center;
    height: calc(100svh - 4rem);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 47.99rem) {
    .home {
      grid-template-columns: minmax(0, 1fr);
    }

    .chart {
      position: relative;
      height: auto;
      padding: 0.5rem 0 1rem;
    }
  }
</style>
