---
import { getCollection } from 'astro:content';
import Shell from '../../components/shell/Shell.astro';
import VisualNovelRecord from '../../components/visual-novels/VisualNovelRecord.astro';
import { compareCompletionDates } from '../../lib/completion-date';
import { stackBySeries } from '../../lib/series';

const novels = (await getCollection('visual-novels')).sort(
  (a, b) =>
    compareCompletionDates(a.data.completed, b.data.completed) ||
    a.data.originalTitle.localeCompare(b.data.originalTitle),
);
const entries = stackBySeries(novels, await getCollection('series'));
---

<Shell title="视觉小说 · cirnonine">
  <main>
    <h1>视觉小说</h1>
    <ol>
      {
        entries.map((entry) =>
          entry.kind === 'record' ? (
            <li>
              <VisualNovelRecord novel={entry.record} heading="h2" />
            </li>
          ) : (
            <li>
              <h2>{entry.series.data.originalTitle}</h2>
              {entry.series.data.translatedTitle && <p>{entry.series.data.translatedTitle}</p>}
              <ol>
                {entry.records.map((novel) => (
                  <li>
                    <VisualNovelRecord novel={novel} heading="h3" />
                  </li>
                ))}
              </ol>
            </li>
          ),
        )
      }
    </ol>
  </main>
</Shell>
