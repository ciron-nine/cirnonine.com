---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Shell from '../../components/shell/Shell.astro';
import { CATEGORY_MUSIC } from '../../lib/background-music';
import { coverColor } from '../../lib/cover-color';
import { detailPage } from '../../lib/detail-page';
import { originalTitleLang, quoteLang } from '../../lib/original-title';
import RecordDate from '../../components/voice/RecordDate.astro';
import Favorite from '../../components/voice/Favorite.astro';
import ShortReview from '../../components/voice/ShortReview.astro';
import ChosenQuote from '../../components/voice/ChosenQuote.astro';
import LongReview from '../../components/voice/LongReview.astro';

export async function getStaticPaths() {
  const games = await getCollection('games');
  return games
    .filter((game) => detailPage(game)?.kind === 'default')
    .map((game) => ({ params: { slug: game.data.slug }, props: { game } }));
}

interface Props {
  game: CollectionEntry<'games'>;
}

const { game } = Astro.props;
const { data } = game;
const { Content } = await render(game);
const color = data.cover && (await coverColor(data.cover));
---

<Shell title={`${data.originalTitle} · 游戏 · cirnonine`} music={{ category: CATEGORY_MUSIC.games }}>
  <main id="main" style={color ? `--cover-color: ${color}` : undefined}>
    <p><a href="/games/">游戏</a></p>
    {data.cover && <Image src={data.cover} alt="" width={480} />}
    <h1 lang={originalTitleLang(data)}>{data.originalTitle}</h1>
    {data.translatedTitle && <p>{data.translatedTitle}</p>}
    <p>{data.developer}</p>
    <RecordDate date={data.completed} />
    {data.favorite && <Favorite />}
    {data.shortReview && <ShortReview text={data.shortReview} />}
    <article>
      <LongReview><Content /></LongReview>
    </article>
    {
      data.quotes.length > 0 && (
        <section>
          <h2>语录</h2>
          {data.quotes.map((quote) => (
            <ChosenQuote {...quote} lang={quoteLang(quote.original, data)} />
          ))}
        </section>
      )
    }
  </main>
</Shell>
