---
import { getCollection } from 'astro:content';
import Shell from '../../components/shell/Shell.astro';
import { CATEGORY_MUSIC } from '../../lib/background-music';
import GameRecord from '../../components/games/GameRecord.astro';
import { compareCompletionDates } from '../../lib/completion-date';
import { stackBySeries } from '../../lib/series';
import { originalTitleLang } from '../../lib/original-title';

const games = (await getCollection('games')).sort(
  (a, b) =>
    compareCompletionDates(a.data.completed, b.data.completed) ||
    a.data.originalTitle.localeCompare(b.data.originalTitle),
);
const entries = stackBySeries(games, await getCollection('series'));
---

<Shell title="游戏 · cirnonine" music={{ category: CATEGORY_MUSIC.games }}>
  <main id="main">
    <h1>游戏</h1>
    <ol>
      {
        entries.map((entry) =>
          entry.kind === 'record' ? (
            <li>
              <GameRecord game={entry.record} heading="h2" />
            </li>
          ) : (
            <li>
              <h2 lang={originalTitleLang(entry.series.data)}>{entry.series.data.originalTitle}</h2>
              {entry.series.data.translatedTitle && <p>{entry.series.data.translatedTitle}</p>}
              <ol>
                {entry.records.map((game) => (
                  <li>
                    <GameRecord game={game} heading="h3" />
                  </li>
                ))}
              </ol>
            </li>
          ),
        )
      }
    </ol>
  </main>
</Shell>
