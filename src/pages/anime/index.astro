---
import { getCollection } from 'astro:content';
import AnimeRecord from '../../components/anime/AnimeRecord.astro';
import { compareCompletionDates } from '../../lib/completion-date';
import { stackBySeries } from '../../lib/series';

const allAnime = (await getCollection('anime')).sort(
  (a, b) =>
    compareCompletionDates(a.data.completed, b.data.completed) ||
    a.data.originalTitle.localeCompare(b.data.originalTitle),
);
const entries = stackBySeries(allAnime, await getCollection('series'));
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>动画 · cirnonine</title>
  </head>
  <body>
    <main>
      <h1>动画</h1>
      <ol>
        {
          entries.map((entry) =>
            entry.kind === 'record' ? (
              <li>
                <AnimeRecord anime={entry.record} heading="h2" />
              </li>
            ) : (
              <li>
                <h2>{entry.series.data.originalTitle}</h2>
                {entry.series.data.translatedTitle && <p>{entry.series.data.translatedTitle}</p>}
                <ol>
                  {entry.records.map((member) => (
                    <li>
                      <AnimeRecord anime={member} heading="h3" />
                    </li>
                  ))}
                </ol>
              </li>
            ),
          )
        }
      </ol>
    </main>
  </body>
</html>
