---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { coverColor } from '../../lib/cover-color';
import { completionDateTimeAttribute, formatCompletionDate } from '../../lib/completion-date';
import { detailPage } from '../../lib/detail-page';
import { formatPremiere } from '../../lib/anime-premiere';

export async function getStaticPaths() {
  const anime = await getCollection('anime');
  return anime
    .filter((entry) => detailPage(entry)?.kind === 'default')
    .map((entry) => ({ params: { slug: entry.data.slug }, props: { anime: entry } }));
}

interface Props {
  anime: CollectionEntry<'anime'>;
}

const { anime } = Astro.props;
const { data } = anime;
const { Content } = await render(anime);
const datetime = completionDateTimeAttribute(data.completed);
const label = formatCompletionDate(data.completed);
const color = data.cover && (await coverColor(data.cover));
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{data.originalTitle} · 动画 · cirnonine</title>
  </head>
  <body>
    <main style={color ? `--cover-color: ${color}` : undefined}>
      <p><a href="/anime/">动画</a></p>
      {data.cover && <Image src={data.cover} alt="" width={480} />}
      <h1>{data.originalTitle}</h1>
      {data.translatedTitle && <p>{data.translatedTitle}</p>}
      <p>
        {formatPremiere(data.year, data.season)}
        {data.episodes && <> · {data.episodes} 集</>}
        · {data.studio}
      </p>
      <p>{datetime ? <time datetime={datetime}>{label}</time> : label}</p>
      {data.favorite && <p>心头好</p>}
      {data.shortReview && <p>{data.shortReview}</p>}
      <article>
        <Content />
      </article>
      {
        data.quotes.length > 0 && (
          <section>
            <h2>语录</h2>
            {data.quotes.map((quote) => (
              <figure>
                <blockquote>
                  <p>{quote.original}</p>
                </blockquote>
                {quote.translation && <p>{quote.translation}</p>}
                <figcaption>
                  {quote.speaker}
                  {quote.source && <> · {quote.source}</>}
                </figcaption>
              </figure>
            ))}
          </section>
        )
      }
    </main>
  </body>
</html>
